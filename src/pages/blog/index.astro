---
import Base from '../../layouts/Base.astro';

// List all markdown posts in /blog (except this index page)
const postModules = import.meta.glob('./*.md', { eager: true });
const posts = Object.entries(postModules)
  .map(([path, mod]) => ({
    slug: path.replace('./', '').replace('.md', ''),
    ...(mod as any).frontmatter,
  }))
  .sort((a: any, b: any) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime());
---

<Base
  title="Packory Blog — E-commerce Disputes, Packing Proof & Seller Guides (Malaysia)"
  description="Guides for Malaysian e-commerce sellers: winning Shopee disputes, empty-box and parcel-swap claims, seller protection, and packing video evidence that holds up."
>
  <header class="blog-nav">
    <div class="container blog-nav-inner">
      <a href="/" class="brand"><span class="brand-dot"></span>Packory</a>
      <nav class="links">
        <a href="/">Home</a>
        <a href="/blog" class="active">Blog</a>
        <a href="https://console.packory.app/signup" class="btn btn-primary btn-sm">Start Free</a>
      </nav>
    </div>
  </header>

  <div class="blog-wrap">
    <div class="container blog-head">
      <p class="blog-kicker">PACKORY BLOG</p>
      <h1>Proof, not promises.</h1>
      <p class="blog-head-sub">Seller guides for Malaysian e-commerce — disputes, empty-box claims, seller protection, and packing evidence that holds up.</p>
    </div>
    <div class="container posts-grid">
      {posts.map((p) => (
        <a class="post-card" href={`/blog/${p.slug}`}>
          <div>
            <span class="post-date">{new Date(p.pubDate).toLocaleDateString('en-MY', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
            <h2>{p.title}</h2>
            <p>{p.description}</p>
          </div>
          <span class="post-more">Read →</span>
        </a>
      ))}
    </div>
  </div>
</Base>

<style is:global>
  .blog-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: rgba(10, 13, 30, 0.92); backdrop-filter: blur(14px); border-bottom: 1px solid rgba(255, 255, 255, 0.1); }
  .blog-nav-inner { display: flex; align-items: center; justify-content: space-between; height: 4.25rem; }
  .blog-nav .brand { display: inline-flex; align-items: center; gap: 0.625rem; color: #fff; font-weight: 700; font-size: 1.15rem; }
  .brand-dot { width: 12px; height: 12px; border-radius: 3px; background: #2f4bff; display: inline-block; }
  .blog-nav .links { display: flex; align-items: center; gap: 1.5rem; font-size: 0.875rem; font-weight: 500; }
  .blog-nav .links a { color: #9aa3b2; }
  .blog-nav .links a:hover, .blog-nav .links a.active { color: #fff; }
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; border-radius: 8px; font-weight: 600; font-size: 0.9375rem; padding: 0.75rem 1.5rem; }
  .btn-primary { background: #2f4bff; color: #fff; box-shadow: 0 6px 20px rgba(47, 75, 255, 0.35); }
  .btn-sm { min-height: 2.5rem; padding: 0.4rem 1.25rem; font-size: 0.8125rem; }
  .blog-wrap { padding: 7.5rem 0 4rem; min-height: 100vh; }
  .blog-head { margin-bottom: 2.5rem; }
  .blog-kicker { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #2f4bff; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }
  .blog-head-sub { color: #6b7280; font-size: 1.0625rem; max-width: 40rem; line-height: 1.6; margin: 0; }
  .posts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1rem; }
  .post-card { display: flex; flex-direction: column; justify-content: space-between; gap: 1.25rem; background: #fff; border: 1px solid rgba(10, 13, 30, 0.1); border-radius: 14px; padding: 1.5rem; transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s; }
  .post-card:hover { transform: translateY(-3px); box-shadow: 0 14px 34px rgba(10, 13, 30, 0.08); border-color: #2f4bff; }
  .post-date { font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: #6b7280; }
  .post-card h2 { font-size: 1.25rem; line-height: 1.3; letter-spacing: -0.01em; margin: 0.5rem 0; color: #0a0d1e; }
  .post-card p { color: #6b7280; font-size: 0.875rem; line-height: 1.6; margin: 0; }
  .post-more { font-family: 'JetBrains Mono', monospace; font-size: 0.8125rem; font-weight: 600; color: #2f4bff; }
</style>
