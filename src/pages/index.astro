---
import Base from '../layouts/Base.astro';

const APP_NAME = 'Packory';
const CONSOLE = 'https://console.packory.app';

const CHANNELS = ['Shopee', 'TikTok Shop', 'Lazada', 'Shopify', 'eBay', 'Amazon', 'WhatsApp', 'Google Drive'];

const PILLARS = [
  { key: 'PROOF', title: 'PROOF', text: 'Every order leaves with video evidence. No he-said-she-said.' },
  { key: 'SPEED', title: 'SPEED', text: 'Hands-free by design. Scan, record, thumbs-up — zero screen touches.' },
  { key: 'TRUST', title: 'TRUST', text: 'Buyers see their order being packed before it ships. Disputes lose their fuel.' },
  { key: 'SCALE', title: 'SCALE', text: 'One camera or fifty. More orders without more chaos or more disputes.' },
];

const WORKFLOW = [
  { label: 'AWB SCAN', done: true },
  { label: 'RECORD', done: true },
  { label: 'THUMBS-UP', done: true },
  { label: 'SYNC TO DRIVE', done: true },
  { label: 'WHATSAPP LINK', done: true },
  { label: 'BUYER SEES PROOF', done: false },
];

const STATIONS = [
  { name: 'STATION A', detail: 'Packing Line 1', orders: '1,248 orders verified', rate: '100% video coverage', status: 'LIVE' },
  { name: 'STATION B', detail: 'Small Parcels', orders: '864 orders verified', rate: '99.2% sync success', status: 'READY' },
  { name: 'STATION C', detail: 'Bulk / COD', orders: 'Pairing…', rate: 'Action needed', status: 'PAIR' },
];

const METRICS = [
  { label: 'Orders today', value: '1,842', mint: true },
  { label: 'Videos captured', value: '1,840', mint: true },
  { label: 'Evidence links delivered', value: '1,832', mint: true },
  { label: 'Dispute win-rate', value: '98.4%', mint: true },
  { label: 'Sync failures', value: '3', mint: false },
  { label: 'On-time WhatsApp delivery', value: '99.1%', mint: true },
];

const KPI = [
  { value: '100%', label: 'ORDERS ON VIDEO' },
  { value: '0', label: 'VIDEO BYTES ON OUR SERVERS' },
  { value: '<24h', label: 'EVIDENCE ON BUYER’S WHATSAPP' },
  { value: '98.4%', label: 'DISPUTES WON WITH VIDEO' },
];

const FEATURES = [
  {
    title: 'Hands-free video proof',
    text: 'AWB detected automatically. Recording starts by itself and stops on a thumbs-up — packers never touch the screen.',
  },
  {
    title: 'Terrible Wi-Fi? No problem',
    text: 'Clips save to the device instantly and sync to the Admin’s private Google Drive in the background, resuming on reconnect.',
  },
  {
    title: 'Zero server video overhead',
    text: 'Your videos never pass through our servers. Bring-your-own Google Drive storage with a scope-limited token.',
  },
  {
    title: 'Dispute-proof orders',
    text: 'Beat parcel-swap and empty-box claims with timestamped, burned-in packing footage delivered to buyers on WhatsApp.',
  },
];

const PRICING = [
  { name: 'Free', price: 'RM 0', features: ['1 licensed camera', 'Manual WhatsApp links', 'Unlimited packing records'] },
  { name: 'Starter', price: 'RM 49/mo', features: ['2 licensed cameras', 'WhatsApp credits available', 'Weekly sheet automation'] },
  { name: 'Pro', price: 'RM 99/mo', features: ['5 licensed cameras', 'Direct seller channel', 'Priority support'] },
  { name: 'Scale', price: 'RM 199/mo', features: ['15 licensed cameras', 'All channels unlocked', 'Onboarding assistance'] },
];

const TESTIMONIALS = [
  {
    quote: 'We won every parcel-swap dispute last month — every single one had video proof.',
    who: 'Shopee seller, 400+ orders/week',
  },
  {
    quote: 'A buyer claimed the box arrived empty. We sent the packing video. Claim closed in a day.',
    who: 'TikTok Shop seller, Malaysia',
  },
];
---

<Base
  title="Packory — Every order. On video. Dispute-proof."
  description="Packory turns any cheap warehouse Android phone into a hands-free packing verification camera. Every order is recorded with a burned-in timestamp, stored in your own Google Drive, and the evidence link is sent straight to the buyer on WhatsApp."
>
  <header class="nav">
    <div class="container nav-inner">
      <a href="/" class="brand">
        <svg class="logo-mark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3 5h10v5H3zM11 14h10v5H11z" stroke="#6045F4" stroke-width="2" stroke-linejoin="round"/>
          <path d="M8 10v3h8v1" stroke="#53E6D4" stroke-width="2" stroke-linecap="round"/>
        </svg>
        {APP_NAME}
      </a>
      <nav class="links">
        <a href="#workflow">Product</a>
        <a href="#pricing">Pricing</a>
        <a href={`${CONSOLE}/login`} class="login">Log In</a>
        <a href={`${CONSOLE}/signup`} class="cta">Start Free</a>
      </nav>
    </div>
  </header>

  <!-- 1. HERO -->
  <section class="snap-screen hero">
    <div class="container hero-inner">
      <span class="eyebrow">PACKING VERIFICATION FOR ECOMMERCE</span>
      <h1>EVERY ORDER.<br /><span class="accent">ON VIDEO.</span><br />DISPUTE-PROOF.</h1>
      <p class="sub">
        Packory turns any cheap warehouse Android phone into a hands-free packing
        verification camera. Every order is recorded with a burned-in timestamp, stored in
        your own Google Drive, and the evidence link is sent straight to the buyer on WhatsApp.
      </p>
      <div class="actions">
        <a href={`${CONSOLE}/signup`} class="btn-primary">START FREE →</a>
        <a href="#workflow" class="btn-outline">SEE HOW IT WORKS</a>
      </div>
      <div class="terminal">
        <div class="term-bar">
          <span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>
          <span class="term-title">packing-terminal · station A</span>
          <span class="live"><span class="pulse"></span>LIVE</span>
        </div>
        <div class="term-body">
          <div class="term-row"><span class="term-label">AWB</span><span class="term-val mint">123456789012 ✓</span></div>
          <div class="term-row"><span class="term-label">Status</span><span class="term-val mint">● RECORDING — UTC 12:04:31</span></div>
          <div class="term-row"><span class="term-label">Sync</span><span class="term-val mint">SYNCED TO DRIVE ✓</span></div>
          <div class="term-row"><span class="term-label">WhatsApp</span><span class="term-val mint">EVIDENCE LINK SENT ✓</span></div>
          <div class="term-flow">
            {['SCAN', 'RECORD', 'SYNC', 'SENT'].map((s, i) => (
              <span class="flow-node"><span class="flow-dot mint"></span>{s}</span>
            ))}
          </div>
        </div>
      </div>
      <div class="stats">
        <div class="stat"><strong>0</strong><span>video bytes on our servers</span></div>
        <div class="stat"><strong>&lt;100ms</strong><span>UI reset after each order</span></div>
        <div class="stat"><strong>24/7</strong><span>background sync &amp; retry</span></div>
        <div class="stat"><strong>1.5s</strong><span>throttled AWB scan rate</span></div>
      </div>
    </div>
  </section>

  <!-- 2. CHANNELS -->
  <section class="snap-screen section light">
    <div class="container">
      <h2>PROVE EVERY ORDER,<br />ON EVERY CHANNEL.</h2>
      <p class="section-sub">One evidence link, sent to the buyer on WhatsApp — regardless of marketplace.</p>
      <div class="channel-grid">
        {CHANNELS.map((c) => (
          <div class="channel">
            <span>{c}</span>
            <span class="connected">CONNECTED ✓</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. PROBLEM -->
  <section class="snap-screen section dark">
    <div class="container">
      <h2 class="on-dark">MORE ORDERS SHOULDN’T<br />MEAN MORE DISPUTES.</h2>
      <div class="problem-grid">
        <div class="problem-box">
          <h3 class="on-dark">BEFORE</h3>
          <ul class="chaos">
            <li>Marketplace dispute</li>
            <li>Buyer claim: “empty box”</li>
            <li>Refund forced</li>
            <li>No proof of packing</li>
            <li>Manual WhatsApp threads</li>
          </ul>
        </div>
        <div class="problem-arrow">→</div>
        <div class="problem-box solid">
          <h3 class="on-dark">WITH PACKORY</h3>
          <ul class="calm">
            <li>Automated, timestamped</li>
            <li>Tamper-evident video</li>
            <li>Evidence on WhatsApp</li>
            <li>Dispute fuel removed</li>
            <li class="mint-text">ONE SYSTEM. EVERY ORDER.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. PILLARS -->
  <section class="snap-screen section light">
    <div class="container">
      <h2>THE PACKORY PILLARS</h2>
      <div class="pillar-grid">
        {PILLARS.map((p) => (
          <div class="pillar">
            <div class="pillar-key">{p.key}</div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. WORKFLOW -->
  <section id="workflow" class="snap-screen section dark">
    <div class="container">
      <h2 class="on-dark">FROM AWB SCAN TO EVIDENCE SENT.<br />AUTOMATICALLY.</h2>
      <div class="workflow">
        {WORKFLOW.map((w, i) => (
          <>
            <div class="wf-step">
              <span class={w.done ? 'wf-dot done' : 'wf-dot'}></span>
              <span class="on-dark">{w.label}</span>
            </div>
            {i < WORKFLOW.length - 1 && <span class="wf-line"></span>}
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. STATIONS + AUTOMATION -->
  <section class="snap-screen section dark">
    <div class="container">
      <h2 class="on-dark">RUN EVERY PACKING STATION<br />FROM ONE PLACE.</h2>
      <div class="station-grid">
        {STATIONS.map((s) => (
          <div class="station">
            <div class="station-head">
              <span class="on-dark">{s.name}</span>
              {s.status === 'LIVE' && <span class="status-live"><span class="pulse"></span>LIVE</span>}
              {s.status === 'READY' && <span class="status-ready">READY</span>}
              {s.status === 'PAIR' && <span class="status-pair">PAIRING…</span>}
            </div>
            <div class="station-detail on-dark-muted">{s.detail}</div>
            <div class="station-orders on-dark">{s.orders}</div>
            <div class="station-rate mint-text">{s.rate}</div>
          </div>
        ))}
      </div>
      <div class="rule">
        <div class="rule-title on-dark"><span class="mint-text">AUTOMATE THE REPETITIVE WORK</span> — LET THE CAMERA DO THE WORK.</div>
        <div class="rule-box">
          <div class="rule-line on-dark"><span class="rule-if">IF</span> AWB barcode detected <span class="rule-then">THEN</span> start recording</div>
          <div class="rule-line on-dark"><span class="rule-if">IF</span> thumbs-up detected <span class="rule-then">THEN</span> stop clip, save to device</div>
          <div class="rule-line on-dark"><span class="rule-if">IF</span> upload complete <span class="rule-then">THEN</span> send WhatsApp link to buyer</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. ANALYTICS -->
  <section class="snap-screen section light">
    <div class="container">
      <h2>SEE WHAT’S HAPPENING BEFORE<br />IT BECOMES A CLAIM.</h2>
      <div class="metric-grid">
        {METRICS.map((m) => (
          <div class="metric">
            <div class="metric-value" style={m.mint ? 'color:#0F1417' : 'color:#0F1417'}>
              {m.value}
              {m.mint && <span class="mint-dot"></span>}
            </div>
            <div class="metric-label">{m.label}</div>
          </div>
        ))}
      </div>
      <div class="kpi-grid">
        {KPI.map((k) => (
          <div class="kpi">
            <div class="kpi-value">{k.value}</div>
            <div class="kpi-label">{k.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. FEATURES -->
  <section id="features" class="snap-screen section light">
    <div class="container">
      <h2>ENGINEERED FOR HOT,<br />NOISY WAREHOUSES.</h2>
      <div class="feature-grid">
        {FEATURES.map((f) => (
          <div class="feature">
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. PRICING -->
  <section id="pricing" class="snap-screen section light">
    <div class="container">
      <h2>PAY PER CAMERA.</h2>
      <p class="section-sub">One license per device. Paid securely via MYR FPX, cards, or local e-wallets.</p>
      <div class="pricing-grid">
        {PRICING.map((p) => (
          <div class="price-card">
            <div class="price-name">{p.name}</div>
            <div class="price-value">{p.price}</div>
            <ul>
              {p.features.map((f) => (
                <li>✓ {f}</li>
              ))}
            </ul>
            <a href={`${CONSOLE}/signup`} class="btn-price">Get started</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. TESTIMONIALS + FINAL CTA -->
  <section class="snap-screen section dark">
    <div class="container">
      <h2 class="on-dark">BUILT FOR SELLERS WHO CAN’T AFFORD<br />ANOTHER EMPTY-BOX CLAIM.</h2>
      <div class="testimonial-grid">
        {TESTIMONIALS.map((t) => (
          <div class="testimonial">
            <p class="on-dark quote">“{t.quote}”</p>
            <div class="testimonial-who mint-text">{t.who}</div>
          </div>
        ))}
      </div>
      <div class="final-cta">
        <h3 class="on-dark">READY TO PUT YOUR ORDERS<br />ON THE RECORD?</h3>
        <p class="on-dark-muted">Turn any Android phone into a hands-free packing verification camera. Free to start. Your videos stay in your own Google Drive.</p>
        <div class="actions">
          <a href={`${CONSOLE}/signup`} class="btn-primary">START FREE →</a>
          <a href={`${CONSOLE}/login`} class="btn-outline">BOOK A DEMO</a>
        </div>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="container footer-inner">
      <span>© {new Date().getFullYear()} {APP_NAME}</span>
      <span>Built for Malaysian e-commerce merchants 🇲🇾</span>
    </div>
  </footer>
</Base>

<style>
  /* ---------- NAV ---------- */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: rgba(15, 20, 23, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(235, 235, 237, 0.08);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.1rem;
    color: #ebebed;
    letter-spacing: -0.01em;
  }

  .logo-mark {
    width: 26px;
    height: 26px;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .links a {
    color: #ebebed;
    opacity: 0.75;
  }

  .links a.login {
    opacity: 0.9;
  }

  .links .cta {
    background: #6045f4;
    color: #fff;
    border-radius: 9999px;
    padding: 0.5rem 1.25rem;
    font-weight: 600;
    opacity: 1;
  }

  /* ---------- SECTIONS ---------- */
  .section {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: 5.5rem;
  }

  .section.light {
    background: #ebebed;
  }

  .section.dark {
    background: #0f1417;
  }

  .snap-screen {
    position: relative;
  }

  h2 {
    font-size: clamp(1.75rem, 4.5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.08;
    color: #0f1417;
    margin-bottom: 1.5rem;
    text-wrap: balance;
  }

  h2.on-dark {
    color: #ebebed;
  }

  .section-sub {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #475569;
    margin-bottom: 2.5rem;
    max-width: 42rem;
  }

  /* ---------- HERO ---------- */
  .hero {
    background: #0f1417;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: 6.5rem;
    padding-bottom: 3.5rem;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    color: #53e6d4;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .hero h1 {
    font-size: clamp(2.4rem, 7vw, 4.75rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: #ebebed;
    text-wrap: balance;
  }

  .hero h1 .accent {
    color: #6045f4;
  }

  .hero .sub {
    max-width: 42rem;
    margin-top: 1.5rem;
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.65;
    color: #9aa3ad;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .btn-primary {
    background: #6045f4;
    color: #fff;
    border-radius: 9999px;
    padding: 0.875rem 1.75rem;
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.01em;
  }

  .btn-outline {
    border: 1px solid rgba(235, 235, 237, 0.35);
    color: #ebebed;
    border-radius: 9999px;
    padding: 0.875rem 1.75rem;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  /* Terminal mockup */
  .terminal {
    width: 100%;
    max-width: 34rem;
    margin-top: 2.5rem;
    border: 1px solid rgba(235, 235, 237, 0.14);
    border-radius: 14px;
    background: #10161b;
    overflow: hidden;
    text-align: left;
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 0.875rem;
    border-bottom: 1px solid rgba(235, 235, 237, 0.08);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot.red { background: #e5484d; }
  .dot.yellow { background: #f5a524; }
  .dot.green { background: #30a46c; }

  .term-title {
    flex: 1;
    font-size: 0.75rem;
    color: #6b7681;
    margin-left: 0.25rem;
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #53e6d4;
  }

  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #53e6d4;
    animation: pulse 1.6s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(83, 230, 212, 0.5); }
    50% { opacity: 0.6; box-shadow: 0 0 0 6px rgba(83, 230, 212, 0); }
  }

  .term-body {
    padding: 0.875rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .term-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.8125rem;
  }

  .term-label {
    width: 5.5rem;
    color: #6b7681;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .term-val {
    color: #ebebed;
    font-weight: 500;
  }

  .term-val.mint {
    color: #53e6d4;
  }

  .term-flow {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 0.5rem;
    padding-top: 0.625rem;
    border-top: 1px solid rgba(235, 235, 237, 0.08);
    flex-wrap: wrap;
  }

  .flow-node {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #ebebed;
  }

  .flow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .flow-dot.mint {
    background: #53e6d4;
  }

  /* Stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    width: 100%;
    max-width: 44rem;
    margin-top: 2rem;
  }

  .stat {
    border: 1px solid rgba(235, 235, 237, 0.12);
    border-radius: 12px;
    padding: 0.875rem 1rem;
    background: rgba(255, 255, 255, 0.02);
  }

  .stat strong {
    display: block;
    font-size: 1.25rem;
    font-weight: 800;
    color: #ebebed;
    letter-spacing: -0.02em;
  }

  .stat span {
    font-size: 0.75rem;
    color: #8a94a0;
    line-height: 1.4;
    display: block;
    margin-top: 0.125rem;
  }

  /* ---------- CHANNELS ---------- */
  .channel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
  }

  .channel {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    border: 1px solid #d5d8dd;
    border-radius: 12px;
    background: #fff;
    padding: 1rem 1.125rem;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .connected {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #0f1417;
    background: #53e6d4;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    width: fit-content;
    border-radius: 9999px;
    padding: 0.2rem 0.55rem;
  }

  /* ---------- PROBLEM ---------- */
  .problem-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
    margin-top: 1.5rem;
  }

  .problem-box {
    border: 1px solid rgba(235, 235, 237, 0.14);
    border-radius: 14px;
    padding: 1.25rem;
  }

  .problem-box.solid {
    border-color: #6045f4;
    background: rgba(96, 69, 244, 0.08);
  }

  .problem-box h3 {
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    margin-bottom: 0.875rem;
  }

  .problem-box ul {
    list-style: none;
