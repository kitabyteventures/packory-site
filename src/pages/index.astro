---
import Base from '../layouts/Base.astro';

const APP_NAME = 'Packory';
const CONSOLE = 'https://console.packory.app';

const CHANNELS = ['Shopee', 'TikTok Shop', 'Lazada', 'Shopify', 'eBay', 'Amazon', 'WhatsApp', 'Google Drive'];

const PILLARS = [
  { n: '01', kicker: 'PROOF', copy: 'Every order leaves with video evidence. No he-said-she-said.' },
  { n: '02', kicker: 'SPEED', copy: 'Hands-free by design. Scan, record, thumbs-up — zero screen touches.' },
  { n: '03', kicker: 'TRUST', copy: 'Buyers see their order being packed before it ships. Disputes lose their fuel.' },
  { n: '04', kicker: 'SCALE', copy: 'One camera or fifty. More orders without more chaos or more disputes.' },
];

const WORKFLOW = [
  { n: '01', label: 'AWB SCAN', copy: 'Barcode detected automatically, hands-free.' },
  { n: '02', label: 'RECORD', copy: 'UTC timestamp burned into every frame.' },
  { n: '03', label: 'THUMBS-UP', copy: 'Gesture stops the clip. Saved instantly.' },
  { n: '04', label: 'SYNC TO DRIVE', copy: 'Background upload, resumes on reconnect.' },
  { n: '05', label: 'WHATSAPP LINK', copy: 'Evidence link sent to buyer automatically.' },
  { n: '06', label: 'BUYER SEES PROOF', copy: 'Their order, packed correctly, on video.' },
];

const STATIONS = [
  { name: 'STATION A', detail: 'PACKING LINE 1', orders: '1,248 VERIFIED', rate: '100% COVERAGE', status: 'LIVE' },
  { name: 'STATION B', detail: 'SMALL PARCELS', orders: '864 VERIFIED', rate: '99.2% SYNC', status: 'READY' },
  { name: 'STATION C', detail: 'BULK / COD', orders: 'PAIRING…', rate: 'ACTION NEEDED', status: 'PAIR' },
];

const METRICS = [
  { label: 'Orders today', value: '1,842' },
  { label: 'Videos captured', value: '1,840' },
  { label: 'Evidence links delivered', value: '1,832' },
  { label: 'Dispute win-rate', value: '98.4%' },
  { label: 'Sync failures', value: '3' },
  { label: 'On-time WhatsApp delivery', value: '99.1%' },
];

const KPI = [
  { value: '100%', label: 'ORDERS ON VIDEO' },
  { value: '0', label: 'VIDEO BYTES ON OUR SERVERS' },
  { value: '<24H', label: 'EVIDENCE ON BUYER’S WHATSAPP' },
  { value: '98.4%', label: 'DISPUTES WON WITH VIDEO' },
];

const FEATURES = [
  {
    title: 'HANDS-FREE VIDEO PROOF',
    text: 'AWB detected automatically. Recording starts by itself and stops on a thumbs-up — packers never touch the screen.',
  },
  {
    title: 'TERRIBLE WI-FI? NO PROBLEM',
    text: 'Clips save to the device instantly and sync to the Admin’s private Google Drive in the background, resuming on reconnect.',
  },
  {
    title: 'ZERO SERVER VIDEO OVERHEAD',
    text: 'Your videos never pass through our servers. Bring-your-own Google Drive storage with a scope-limited token.',
  },
  {
    title: 'DISPUTE-PROOF ORDERS',
    text: 'Beat parcel-swap and empty-box claims with timestamped, burned-in packing footage delivered to buyers on WhatsApp.',
  },
];

const PRICING = [
  { name: 'FREE', price: 'RM 0', features: ['1 licensed camera', 'Manual WhatsApp links', 'Unlimited packing records'] },
  { name: 'STARTER', price: 'RM 49/MO', features: ['2 licensed cameras', 'WhatsApp credits available', 'Weekly sheet automation'] },
  { name: 'PRO', price: 'RM 99/MO', features: ['5 licensed cameras', 'Direct seller channel', 'Priority support'] },
  { name: 'SCALE', price: 'RM 199/MO', features: ['15 licensed cameras', 'All channels unlocked', 'Onboarding assistance'] },
];

const TESTIMONIALS = [
  {
    quote: 'We won every parcel-swap dispute last month — every single one had video proof.',
    who: 'SHOPEE SELLER · 400+ ORDERS/WEEK',
  },
  {
    quote: 'A buyer claimed the box arrived empty. We sent the packing video. Claim closed in a day.',
    who: 'TIKTOK SHOP SELLER · MALAYSIA',
  },
];
---

<Base
  title="Packory — Every order. On video. Dispute-proof."
  description="Packory turns any cheap warehouse Android phone into a hands-free packing verification camera. Every order is recorded with a burned-in timestamp, stored in your own Google Drive, and the evidence link is sent straight to the buyer on WhatsApp."
>
  <header class="topbar">
    <div class="brand">{APP_NAME}.</div>
    <nav class="nav">
      <a href="#work">Product</a>
      <a href="#pricing">Pricing</a>
      <a href={`${CONSOLE}/login`}>Log In</a>
      <a href={`${CONSOLE}/signup`} class="nav-cta">Start Free</a>
    </nav>
  </header>

  <!-- 1. HERO -->
  <section class="hero">
    <aside class="meta-rail"><div class="n">01</div><div class="year">2026<br />Selected</div><div class="menu-mark"></div></aside>
    <div class="left">
      <div class="wordmark">PACKORY</div>
      <h1 class="title" style="margin-top:9vh">EVERY<br />ORDER.<br />ON VIDEO.<br /><span class="t-orange">DISPUTE-PROOF.</span></h1>
      <p class="copy" style="margin-top:26px">Hands-free packing verification. Timestamped video evidence, synced to your own Google Drive, delivered to the buyer on WhatsApp.</p>
      <div class="hero-actions" style="margin-top:32px">
        <a href={`${CONSOLE}/signup`} class="btn-solid">Start Free</a>
        <a href="#work" class="btn-ghost">See How It Works</a>
      </div>
    </div>
    <div class="right">
      <div class="big-circle">
        <div class="term">
          <div class="term-bar"><span class="term-title">PACKING-TERMINAL · A</span><span class="live"><span class="pulse"></span>LIVE</span></div>
          <div class="term-body">
            <div class="term-row"><span class="tl">AWB</span><span class="tv">123456789012 <span class="ok">✓</span></span></div>
            <div class="term-row"><span class="tl">STATUS</span><span class="tv"><span class="rec"></span> RECORDING</span></div>
            <div class="term-row"><span class="tl">SYNC</span><span class="tv">SYNCED <span class="ok">✓</span></span></div>
            <div class="term-row"><span class="tl">WA</span><span class="tv">LINK SENT <span class="ok">✓</span></span></div>
          </div>
          <div class="term-bc"><span class="bc-bars"></span><span class="bc-text">PKR-0A3F-9C2E-7741</span></div>
        </div>
      </div>
      <div class="hatch"></div>
      <div class="dot"></div>
    </div>
  </section>

  <!-- 2. CHANNELS -->
  <section id="work" class="section white">
    <aside class="meta-rail"><div class="n">02</div><div class="year">2026<br />Work</div><div class="menu-mark"></div></aside>
    <div class="section-body">
      <div class="wordmark">CONNECTED.</div>
      <h2 class="title" style="margin-top:34px">PROVE EVERY ORDER.<br />ON EVERY CHANNEL.</h2>
      <p class="copy" style="margin-top:18px">One evidence link, sent to the buyer on WhatsApp — regardless of marketplace.</p>
      <div class="editorial-grid" style="margin-top:40px">
        {CHANNELS.map((c, i) => (
          <div class={`chan chan-${i % 3}`}>
            <span class="chan-name">{c}</span>
            <span class="chan-status"><span class="dot-sm"></span>CONNECTED</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. PROBLEM — split color -->
  <section class="split-color">
    <div class="teal-panel">
      <div class="wordmark">THE PROBLEM</div>
      <h2 class="title" style="margin-top:52px">MORE ORDERS<br />SHOULDN’T MEAN<br />MORE DISPUTES.</h2>
      <p class="copy" style="margin-top:28px">Parcel-swap and empty-box claims force refunds with no proof. The marketplace has no video — so someone always loses.</p>
    </div>
    <div class="orange-panel">
      <div class="chaos-list">
        <div class="chaos-item"><span class="x">×</span><span>Marketplace dispute</span></div>
        <div class="chaos-item"><span class="x">×</span><span>Buyer claim: “empty box”</span></div>
        <div class="chaos-item"><span class="x">×</span><span>Refund forced</span></div>
        <div class="chaos-item"><span class="x">×</span><span>No proof of packing</span></div>
        <div class="chaos-item ok-item"><span class="ok-mark">✓</span><span>With Packory: evidence on WhatsApp</span></div>
      </div>
    </div>
  </section>

  <!-- 4. PILLARS -->
  <section id="about" class="section white">
    <aside class="meta-rail"><div class="n">03</div><div class="year">2026<br />System</div><div class="menu-mark"></div></aside>
    <div class="section-body">
      <div class="grid-2">
        <div>
          <div class="wordmark teal-dot">WHY PACKORY</div>
          <h2 class="title" style="margin-top:38px">FOUR PILLARS.<br />ONE OUTCOME:<br />TRUST.</h2>
        </div>
        <div class="lines">
          {PILLARS.map((p) => (
            <div class="line-item"><b>{p.n}</b><span class="kicker">{p.kicker}</span><span class="copy">{p.copy}</span></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 5. WORKFLOW -->
  <section class="section teal">
    <aside class="meta-rail"><div class="n">04</div><div class="year">2026<br />Flow</div><div class="menu-mark"></div></aside>
    <div class="section-body">
      <div class="wordmark">HOW IT WORKS</div>
      <h2 class="title" style="margin-top:34px">AWB SCAN TO EVIDENCE SENT.<br />AUTOMATICALLY.</h2>
      <div class="lines" style="margin-top:44px">
        {WORKFLOW.map((w) => (
          <div class="line-item"><b>{w.n}</b><span class="kicker">{w.label}</span><span class="copy">{w.copy}</span></div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. STATIONS -->
  <section id="studio" class="section orange">
    <aside class="meta-rail"><div class="n">05</div><div class="year">2026<br />Ops</div><div class="menu-mark"></div></aside>
    <div class="section-body">
      <div class="wordmark teal-dot">OPERATIONS</div>
      <h2 class="title" style="margin-top:34px">RUN EVERY STATION<br />FROM ONE PLACE.</h2>
      <div class="gallery-wall" style="margin-top:44px">
        {STATIONS.map((s) => (
          <div class="station-card">
            <div class="sc-head">
              <span class="sc-name">{s.name}</span>
              {s.status === 'LIVE' && <span class="sc-live"><span class="pulse"></span>LIVE</span>}
              {s.status === 'READY' && <span class="sc-ready">READY</span>}
              {s.status === 'PAIR' && <span class="sc-pair">PAIRING…</span>}
            </div>
            <div class="sc-detail">{s.detail}</div>
            <div class="sc-orders">{s.orders}</div>
            <div class="sc-rate">{s.rate}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. ANALYTICS -->
  <section class="section white">
    <aside class="meta-rail"><div class="n">06</div><div class="year">2026<br />Data</div><div class="menu-mark"></div></aside>
    <div class="section-body">
      <div class="wordmark">ANALYTICS</div>
      <h2 class="title" style="margin-top:34px">SEE WHAT’S HAPPENING<br />BEFORE IT BECOMES A CLAIM.</h2>
      <div class="metric-row" style="margin-top:40px">
        {METRICS.map((m) => (
          <div class="metric"><b>{m.value}</b><span class="kicker">{m.label}</span></div>
        ))}
      </div>
      <div class="kpi-row" style="margin-top:26px">
        {KPI.map((k) => (
          <div class="kpi"><b>{k.value}</b><span class="kicker">{k.label}</span></div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. FEATURES -->
  <section id="features" class="section white">
    <aside class="meta-rail"><div class="n">07</div><div class="year">2026<br />Build</div><div class="menu-mark"></div></aside>
    <div class="section-body">
      <div class="wordmark teal-dot">FEATURES</div>
      <h2 class="title" style="margin-top:34px">ENGINEERED FOR HOT,<br />NOISY WAREHOUSES.</h2>
      <div class="feature-grid" style="margin-top:40px">
        {FEATURES.map((f, i) => (
          <div class={`feature f-${i % 2}`}>
            <div class="kicker">{f.title}</div>
            <p class="copy" style="margin-top:12px">{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. PRICING -->
  <section id="pricing" class="section peach">
    <aside class="meta-rail"><div class="n">08</div><div class="year">2026<br />Plan</div><div class="menu-mark"></div></aside>
    <div class="section-body">
      <div class="wordmark">PRICING</div>
      <h2 class="title" style="margin-top:34px">PAY PER CAMERA.</h2>
      <p class="copy" style="margin-top:16px">One license per device. Paid securely via MYR FPX, cards, or local e-wallets.</p>
      <div class="pricing-grid" style="margin-top:38px">
        {PRICING.map((p, i) => (
          <div class={`price p-${i % 2}`}>
            <div class="kicker">{p.name}</div>
            <div class="price-val">{p.price}</div>
            <ul>
              {p.features.map((f) => (<li><span class="li-check">✓</span>{f}</li>))}
            </ul>
            <a href={`${CONSOLE}/signup`} class="btn-price">GET STARTED</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. TESTIMONIALS + CTA -->
  <section id="contact" class="contact">
    <aside class="meta-rail"><div class="n">09</div><div class="year">2026<br />Proof</div><div class="menu-mark"></div></aside>
    <div class="section-body">
      <div class="wordmark">CUSTOMERS</div>
      <div class="testi-grid" style="margin-top:30px">
        {TESTIMONIALS.map((t) => (
          <div class="testi"><p class="t-quote">“{t.quote}”</p><span class="kicker">{t.who}</span></div>
        ))}
      </div>
      <h2 class="title big" style="margin-top:52px">READY TO PUT<br />YOUR ORDERS<br />ON THE RECORD?</h2>
      <div class="hero-actions" style="margin-top:34px">
        <a href={`${CONSOLE}/signup`} class="btn-solid">Start Free</a>
        <a href={`${CONSOLE}/login`} class="btn-ghost">Book a Demo</a>
      </div>
    </div>
  </section>

  <footer class="footer">
    <span>© {new Date().getFullYear()} PACKORY</span>
    <span>BUILT FOR MALAYSIAN E-COMMERCE MERCHANTS 🇲🇾</span>
  </footer>
</Base>

<style>
  :root {
    --orange: #fd8405; --teal: #13b9b6; --white: #fefefd; --charcoal: #341c19;
    --burnt: #e45507; --tangerine: #f89437; --mist: #bfd1ce; --peach: #f2b279;
  }
  * { box-sizing: border-box; }

  /* ===== BASE (ikut reference) ===== */
  .topbar {
    position: sticky; top: 0; z-index: 20; height: 72px;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 5vw; background: rgba(254,254,253,.96);
    border-bottom: 1px solid rgba(52,28,25,.12);
  }
  .brand { font-weight: 900; letter-spacing: -.04em; font-size: 21px; text-transform: uppercase; }
  .nav { display: flex; gap: 28px; font-size: 11px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; align-items: center; }
  .nav a { color: var(--charcoal); opacity: .75; transition: opacity .15s; }
  .nav a:hover { opacity: 1; }
  .nav .nav-cta { background: var(--orange); color: var(--charcoal); padding: 10px 20px; opacity: 1; }

  .kicker { font-size: 10px; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; }
  .copy { font-size: 11px; line-height: 1.65; max-width: 36ch; }
  .title { margin: 0; font-size: clamp(30px, 4.4vw, 62px); line-height: .92; font-weight: 900; letter-spacing: -.04em; text-transform: uppercase; }
  .wordmark { position: relative; z-index: 1; display: inline-block; font-size: clamp(22px, 3vw, 40px); font-weight: 900; letter-spacing: -.04em; text-transform: uppercase; }
  .wordmark::before { content: ""; position: absolute; z-index: -1; width: .92em; height: .92em; border-radius: 50%; left: -.28em; top: 50%; transform: translateY(-50%); background: var(--orange); }
  .wordmark.teal-dot::before { background: var(--teal); }
  .dot { width: 32px; height: 32px; border-radius: 50%; background: var(--teal); }
  .dot-sm { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); display: inline-block; }
  .hatch { width: 44px; height: 44px; border-radius: 50%; background: repeating-linear-gradient(45deg, transparent 0 2px, rgba(255,255,255,.65) 2px 3px); }

  .meta-rail { position: relative; padding: 22px 18px; border-right: 1px solid currentColor; min-width: 76px; }
  .meta-rail .n { font-size: 17px; font-weight: 800; margin-bottom: 72px; }
  .meta-rail .year { position: absolute; left: 18px; bottom: 70px; font-size: 8px; line-height: 1.4; }
  .menu-mark { position: absolute; left: 18px; bottom: 18px; width: 22px; height: 14px; }
  .menu-mark::before, .menu-mark::after { content: ""; position: absolute; left: 0; height: 4px; border-radius: 4px; background: currentColor; }
  .menu-mark::before { width: 18px; top: 1px; } .menu-mark::after { width: 22px; bottom: 1px; }

  /* ===== HERO (reference: 110px 1.05fr .95fr) ===== */
  .hero { min-height: calc(100vh - 72px); display: grid; grid-template-columns: 110px 1.05fr .95fr; background: var(--white); }
  .hero .left { background: var(--teal); color: white; padding: 6vw; display: flex; flex-direction: column; justify-content: center; }
  .hero .left .title { color: white; }
  .hero .left .t-orange { color: var(--orange); }
  .hero .left .copy { color: rgba(255,255,255,.85); }
  .hero .right { background: var(--orange); padding: 4vw; display: flex; align-items: center; justify-content: center; position: relative; }
  .hero .right .big-circle { width: min(30vw, 440px); height: min(30vw, 440px); border-radius: 50%; overflow: hidden; background: var(--charcoal); display: flex; align-items: center; justify-content: center; }
  .hero .right .hatch { position: absolute; right: 8%; top: 10%; }
  .hero .right .dot { position: absolute; right: 8%; bottom: 8%; }

  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .btn-solid { background: var(--orange); color: var(--charcoal); padding: 14px 26px; font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .btn-ghost { border: 1px solid rgba(255,255,255,.5); color: white; padding: 13px 24px; font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }

  /* terminal dalam big circle */
  .term { width: 72%; text-align: left; color: white; }
  .term-bar { display: flex; justify-content: space-between; align-items: center; padding-bottom: 8px; border-bottom: 1px solid rgba(255,255,255,.2); font-size: 8px; letter-spacing: .14em; }
  .term-title { color: rgba(255,255,255,.6); font-weight: 700; }
  .live { display: inline-flex; align-items: center; gap: 5px; color: var(--teal); font-weight: 800; }
  .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); animation: pulse 1.6s ease-in-out infinite; }
  @keyframes pulse { 0%,100% { opacity:1; box-shadow:0 0 0 0 rgba(19,185,182,.5);} 50% { opacity:.55; box-shadow:0 0 0 6px rgba(19,185,182,0);} }
  .term-body { padding-top: 10px; display: flex; flex-direction: column; gap: 7px; font-size: 9px; }
  .term-row { display: flex; gap: 8px; align-items: baseline; }
  .tl { width: 44px; color: rgba(255,255,255,.5); font-weight: 700; font-size: 7px; letter-spacing: .1em; }
  .tv { font-weight: 500; }
  .ok { color: var(--teal); font-weight: 800; }
  .rec { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--orange); animation: pulse 1.6s infinite; }
  .term-bc { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,.2); }
  .bc-bars { height: 14px; width: 70px; background-image: repeating-linear-gradient(90deg, white 0 2px, transparent 2px 4px, white 4px 5px, transparent 5px 9px); opacity: .6; }
  .bc-text { font-size: 6px; letter-spacing: .14em; color: rgba(255,255,255,.5); }

  /* ===== SECTION ===== */
  .section { display: grid; grid-template-columns: 110px 1fr; min-height: 640px; }
  .section.white { background: var(--white); color: var(--charcoal); }
  .section.teal { background: var(--teal); color: white; }
  .section.orange { background: var(--orange); color: white; }
  .section.peach { background: var(--peach); color: var(--charcoal); }
  .section-body { padding: 6vw; }

  /* editorial grid → channels */
  .editorial-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .chan { border: 2px solid var(--charcoal); padding: 18px 16px; display: flex; flex-direction: column; gap: 14px; }
  .chan-0 { background: var(--white); }
  .chan-1 { background: var(--peach); }
  .chan-2 { background: var(--teal); color: white; }
  .chan-name { font-size: 13px; font-weight: 900; letter-spacing: .04em; text-transform: uppercase; }
  .chan-status { font-size: 8px; font-weight: 800; letter-spacing: .14em; display: inline-flex; align-items: center; gap: 6px; }

  /* split-color */
  .split-color { display: grid; grid-template-columns: .85fr 1.5fr; min-height: 620px; }
  .split-color .teal-panel { background: var(--teal); color: white; padding: 6vw; display: flex; flex-direction: column; justify-content: center; }
  .split-color .teal-panel .copy { color: rgba(255,255,255,.85); }
  .split-color .orange-panel { background: var(--tangerine); padding: 5vw; display: flex; align-items: center; justify-content: center; }
  .chaos-list { width: 100%; max-width: 420px; border: 2px solid var(--charcoal); background: var(--white); color: var(--charcoal); }
  .chaos-item { display: flex; gap: 12px; align-items: center; padding: 16px 20px; border-bottom: 1px solid rgba(52,28,25,.15); font-size: 11px; font-weight: 600; }
  .chaos-item:last-child { border-bottom: none; }
  .x { color: var(--burnt); font-weight: 900; }
  .ok-mark { color: var(--teal); font-weight: 900; }
  .ok-item { background: var(--charcoal); color: white; }

  /* lines */
  .lines { margin-top: 42px; border-top: 1px solid currentColor; }
  .line-item { display: grid; grid-template-columns: 60px 1fr 1fr; gap: 30px; padding: 24px 0; border-bottom: 1px solid currentColor; align-items: baseline; }
  .line-item b { font-size: 17px; font-weight: 800; }

  /* gallery wall → stations */
  .gallery-wall { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }
  .station-card { background: var(--charcoal); color: white; padding: 22px; display: flex; flex-direction: column; gap: 6px; border: 2px solid var(--charcoal); }
  .sc-head { display: flex; justify-content: space-between; align-items: center; }
  .sc-name { font-size: 13px; font-weight: 900; letter-spacing: .1em; }
  .sc-live { display: inline-flex; align-items: center; gap: 5px; color: var(--teal); font-size: 9px; font-weight: 800; letter-spacing: .12em; }
