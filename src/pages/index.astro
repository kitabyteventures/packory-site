---
import Base from '../layouts/Base.astro';

const APP_NAME = 'Packory';
const CONSOLE = 'https://console.packory.app';

const STATS = [
  ['0', 'video bytes on our servers'],
  ['<100ms', 'UI reset after each order'],
  ['24/7', 'background sync & retry'],
  ['1.5s', 'throttled AWB scan rate'],
];

const CHANNELS = ['Shopee', 'TikTok Shop', 'Lazada', 'Shopify', 'eBay', 'Amazon', 'WhatsApp', 'Google Drive'];

const FIT = [
  { title: 'Shopee sellers', text: 'Win parcel-swap and empty-box disputes with timestamped packing video, delivered to the buyer on WhatsApp.' },
  { title: 'TikTok Shop sellers', text: 'Keep up with fast order flow without QC staff. The camera watches. The evidence files itself.' },
  { title: 'Multi-channel brands', text: 'One system across Shopee, TikTok, Lazada and more — one evidence link per order, every channel.' },
  { title: 'Packing operations', text: 'Run every station from one dashboard. Live status, sync health, dispute win-rate.' },
];

const PILLARS = [
  { n: '01', kicker: 'Proof', copy: 'Every order leaves with video evidence. No he-said-she-said.' },
  { n: '02', kicker: 'Speed', copy: 'Hands-free by design. Scan, record, thumbs-up — zero screen touches.' },
  { n: '03', kicker: 'Trust', copy: 'Buyers see their order being packed before it ships. Disputes lose their fuel.' },
  { n: '04', kicker: 'Scale', copy: 'One camera or fifty. More orders without more chaos or more disputes.' },
];

const WORKFLOW = [
  { label: 'AWB SCAN', copy: 'Barcode detected automatically at 1 frame per 1.5s.' },
  { label: 'RECORD', copy: 'Camera records hands-free. UTC timestamp burned into every frame.' },
  { label: 'THUMBS-UP', copy: 'Gesture stops the clip. Saved instantly to the device.' },
  { label: 'SYNC TO DRIVE', copy: 'Background upload to your own Google Drive. Resumes on reconnect.' },
  { label: 'WHATSAPP LINK', copy: 'Masked evidence link sent to the buyer automatically.' },
  { label: 'BUYER SEES PROOF', copy: 'Their order, packed correctly, on video — before it ships.' },
];

const FEATURES = [
  { title: 'Hands-free video proof', text: 'AWB detected automatically. Recording starts by itself and stops on a thumbs-up — packers never touch the screen.' },
  { title: 'Terrible Wi-Fi? No problem', text: 'Clips save to the device instantly and sync to the Admin’s private Google Drive in the background, resuming on reconnect.' },
  { title: 'Zero server video overhead', text: 'Your videos never pass through our servers. Bring-your-own Google Drive storage with a scope-limited token.' },
  { title: 'Dispute-proof orders', text: 'Beat parcel-swap and empty-box claims with timestamped, burned-in packing footage delivered to buyers on WhatsApp.' },
];

const PRICING = [
  { name: 'Free', price: 'RM 0', features: ['1 licensed camera', 'Manual WhatsApp links', 'Unlimited packing records'] },
  { name: 'Starter', price: 'RM 49/mo', features: ['2 licensed cameras', 'WhatsApp credits available', 'Weekly sheet automation'] },
  { name: 'Pro', price: 'RM 99/mo', features: ['5 licensed cameras', 'Direct seller channel', 'Priority support'] },
  { name: 'Scale', price: 'RM 199/mo', features: ['15 licensed cameras', 'All channels unlocked', 'Onboarding assistance'] },
];

const FAQS = [
  { q: 'What is Packory?', a: 'Packory turns any cheap warehouse Android phone into a hands-free packing verification camera. Every order is recorded with a burned-in timestamp, stored in your own Google Drive, and the evidence link is sent straight to the buyer on WhatsApp.' },
  { q: 'Where are the videos stored?', a: 'On your own Google Drive. Videos never pass through our servers — bring-your-own storage with a scope-limited token. Zero server video overhead.' },
  { q: 'Does it need good Wi-Fi?', a: 'No. Clips save instantly on the device, then sync to Drive in the background, resuming automatically on reconnect. Works in hot, noisy warehouses with terrible Wi-Fi.' },
  { q: 'How does the packing stop?', a: 'Hands-free. The packer shows a thumbs-up and the clip stops automatically — no screen touching, no buttons, no workflow interruption.' },
  { q: 'What does it cost?', a: 'Pay per camera. Free tier includes 1 licensed camera. Starter RM49/mo, Pro RM99/mo, Scale RM199/mo. Paid securely via MYR FPX, cards, or local e-wallets.' },
  { q: 'Which platforms does it work with?', a: 'Any marketplace. Evidence links are delivered on WhatsApp, so it works with Shopee, TikTok Shop, Lazada, Shopify, eBay and more.' },
];

const TESTIMONIALS = [
  { quote: 'We won every parcel-swap dispute last month — every single one had video proof.', who: 'Shopee seller · 400+ orders/week' },
  { quote: 'A buyer claimed the box arrived empty. We sent the packing video. Claim closed in a day.', who: 'TikTok Shop seller · Malaysia' },
];
---

<Base
  title="Packory — Every order. On video. Dispute-proof."
  description="Packory turns any cheap warehouse Android phone into a hands-free packing verification camera. Every order is recorded with a burned-in timestamp, stored in your own Google Drive, and the evidence link is sent straight to the buyer on WhatsApp."
>
  <!-- NAV -->
  <header class="nav">
    <div class="container nav-inner">
      <a href="/" class="brand">
        <span class="brand-dot"></span>
        {APP_NAME}
      </a>
      <nav class="links">
        <a href="#workflow">Workflow</a>
        <a href="#features">Features</a>
        <a href="#pricing">Pricing</a>
        <a href="#faq">FAQ</a>
        <a href={`${CONSOLE}/login`}>Log In</a>
        <a href={`${CONSOLE}/signup`} class="btn btn-primary btn-sm">Start Free</a>
      </nav>
    </div>
  </header>

  <!-- HERO -->
  <section class="snap-screen hero">
    <div class="hero-grid container">
      <div class="hero-copy">
        <p class="eyebrow"><span class="rec-dot"></span>PACKING VERIFICATION FOR ECOMMERCE</p>
        <h1>Every order.<br />On video.<br /><span class="hl-blue">Dispute-proof.</span></h1>
        <p class="hero-sub">
          Packory turns any cheap warehouse Android phone into a hands-free packing
          verification camera. Every order is recorded with a burned-in timestamp, stored in
          your own Google Drive, and the evidence link is sent straight to the buyer on WhatsApp.
        </p>
        <div class="hero-actions">
          <a href={`${CONSOLE}/signup`} class="btn btn-primary">Start Free</a>
          <a href="#workflow" class="btn btn-ghost">See how it works</a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="terminal-frame">
          <div class="term-bar">
            <span class="term-title">packing-terminal · station A</span>
            <span class="live"><span class="rec-dot"></span>LIVE</span>
          </div>
          <div class="term-body">
            <div class="term-row"><span class="tl">AWB</span><span class="tv">123456789012 <span class="ok">✓</span></span></div>
            <div class="term-row"><span class="tl">STATUS</span><span class="tv"><span class="rec-dot"></span> RECORDING — UTC 12:04:31</span></div>
            <div class="term-row"><span class="tl">SYNC</span><span class="tv">Synced to Drive <span class="ok">✓</span></span></div>
            <div class="term-row"><span class="tl">WHATSAPP</span><span class="tv">Evidence link sent <span class="ok">✓</span></span></div>
          </div>
          <div class="term-barcode">
            <span class="bc-bars"></span>
            <span class="bc-text">PKR-0A3F-9C2E-7741 · VERIFIED</span>
          </div>
        </div>
        <div class="hero-badge">
          <span class="badge-check">✓</span>
          <div>
            <strong>VERIFIED</strong>
            <small>evidence on buyer’s WhatsApp</small>
          </div>
        </div>
      </div>
    </div>
    <div class="stats">
      <div class="stat"><strong>0</strong><span>video bytes on our servers</span></div>
      <div class="stat"><strong>&lt;100ms</strong><span>UI reset after each order</span></div>
      <div class="stat"><strong>24/7</strong><span>background sync &amp; retry</span></div>
      <div class="stat"><strong>1.5s</strong><span>throttled AWB scan rate</span></div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="workflow" class="snap-screen section light">
    <div class="container">
      <p class="eyebrow-dark">HOW IT WORKS</p>
      <h2>From AWB scan to evidence sent.<br />Automatically.</h2>
      <div class="steps">
        {WORKFLOW.map((w, i) => (
          <div class="step">
            <span class="step-num">0{i + 1}</span>
            <h3>{w.label}</h3>
            <p>{w.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CHANNELS -->
  <section class="snap-screen section paper">
    <div class="container">
      <p class="eyebrow-dark">INTEGRATIONS</p>
      <h2>Prove every order,<br />on every channel.</h2>
      <p class="section-sub">One evidence link, sent to the buyer on WhatsApp — regardless of marketplace.</p>
      <div class="channel-grid">
        {CHANNELS.map((c, i) => (
          <div class="channel">
            <span class="channel-name">{c}</span>
            <span class="connected"><span class="dot-blue"></span>CONNECTED</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PILLARS -->
  <section class="snap-screen section light">
    <div class="container">
      <p class="eyebrow-dark">WHY PACKORY</p>
      <h2>Four pillars.<br />One outcome: trust.</h2>
      <div class="pillar-grid">
        {PILLARS.map((p) => (
          <div class="pillar">
            <span class="pillar-num">{p.n}</span>
            <h3>{p.kicker}</h3>
            <p>{p.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OPERATIONS (dark) -->
  <section class="snap-screen section dark ops">
    <div class="container">
      <p class="eyebrow">OPERATIONS</p>
      <h2 class="on-dark">Run every packing station<br />from one place.</h2>
      <div class="station-grid">
        {[
          { name: 'STATION A', detail: 'Packing Line 1', orders: '1,248 orders verified', rate: '100% video coverage', status: 'LIVE' },
          { name: 'STATION B', detail: 'Small Parcels', orders: '864 orders verified', rate: '99.2% sync success', status: 'READY' },
          { name: 'STATION C', detail: 'Bulk / COD', orders: 'Pairing…', rate: 'Action needed', status: 'PAIR' },
        ].map((s) => (
          <div class="station">
            <div class="station-head">
              <span class="on-dark station-name">{s.name}</span>
              {s.status === 'LIVE' && <span class="status-live"><span class="rec-dot"></span>LIVE</span>}
              {s.status === 'READY' && <span class="status-ready">READY</span>}
              {s.status === 'PAIR' && <span class="status-pair">PAIRING…</span>}
            </div>
            <div class="station-detail on-dark-muted">{s.detail}</div>
            <div class="station-orders on-dark">{s.orders}</div>
            <div class="station-rate mint">{s.rate}</div>
          </div>
        ))}
      </div>
      <div class="rule">
        <p class="label-dark">AUTOMATE THE REPETITIVE WORK</p>
        <div class="rule-title on-dark">Let the camera do the work.</div>
        <div class="rule-box">
          <div class="rule-line on-dark"><span class="rule-if">IF</span> AWB barcode detected <span class="rule-then">THEN</span> start recording</div>
          <div class="rule-line on-dark"><span class="rule-if">IF</span> thumbs-up detected <span class="rule-then">THEN</span> stop clip, save to device</div>
          <div class="rule-line on-dark"><span class="rule-if">IF</span> upload complete <span class="rule-then">THEN</span> send WhatsApp link to buyer</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section id="features" class="snap-screen section light">
    <div class="container">
      <p class="eyebrow-dark">FEATURES</p>
      <h2>Engineered for hot,<br />noisy warehouses.</h2>
      <div class="feature-grid">
        {FEATURES.map((f, i) => (
          <div class="feature">
            <span class="feature-num">0{i + 1}</span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="snap-screen section paper">
    <div class="container">
      <p class="eyebrow-dark">CUSTOMERS</p>
      <h2>Built for sellers who can’t afford<br />another empty-box claim.</h2>
      <div class="testi-grid">
        {TESTIMONIALS.map((t) => (
          <div class="testi">
            <p>“{t.quote}”</p>
            <footer>{t.who}</footer>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section id="pricing" class="snap-screen section light">
    <div class="container">
      <p class="eyebrow-dark">PRICING</p>
      <h2>Pay per camera.</h2>
      <p class="section-sub">One license per device. Paid securely via MYR FPX, cards, or local e-wallets.</p>
      <div class="pricing-grid">
        {PRICING.map((p) => (
          <div class="price-card">
            <div class="price-name">{p.name}</div>
            <div class="price-value">{p.price}</div>
            <ul>
              {p.features.map((f) => (
                <li><span class="li-check">✓</span> {f}</li>
              ))}
            </ul>
            <a href={`${CONSOLE}/signup`} class="btn btn-primary btn-block">Get started</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="snap-screen section paper">
    <div class="container faq-grid">
      <div>
        <p class="eyebrow-dark">FAQ</p>
        <h2>The things every<br />seller asks.</h2>
      </div>
      <div class="faq-list">
        {FAQS.map((f) => (
          <details class="faq-item">
            <summary>{f.q}<span class="faq-plus"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="snap-screen section dark cta">
    <div class="container cta-inner">
      <p class="eyebrow">GET STARTED</p>
      <h2 class="on-dark">Ready to put your orders<br />on the record?</h2>
      <p class="cta-sub">Turn any Android phone into a hands-free packing verification camera. Free to start. Your videos stay in your own Google Drive.</p>
      <div class="hero-actions">
        <a href={`${CONSOLE}/signup`} class="btn btn-primary">Start Free</a>
        <a href={`${CONSOLE}/login`} class="btn btn-ghost">Book a demo</a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container footer-inner">
      <span>© {new Date().getFullYear()} {APP_NAME}</span>
      <span>Built for Malaysian e-commerce merchants 🇲🇾</span>
      <span class="footer-tag">EVERY ORDER. ON VIDEO. DISPUTE-PROOF.</span>
    </div>
  </footer>
</Base>

<style>
  /* ===== THE VERIFICATION LAYER — ink + electric blue + REC red ===== */
  :root {
    --ink: #0a0d1e;          /* authority — the record */
    --ink-2: #10142b;        /* raised dark surface */
    --ink-3: #171c36;
    --blue: #2f4bff;         /* trust & action */
    --blue-soft: #e8ecff;
    --red: #ff3b30;          /* REC — evidence capture only */
    --paper: #f7f7f4;        /* warm clarity */
    --white: #ffffff;
    --slate: #6b7280;        /* muted on light */
    --steel: #9aa3b2;        /* muted on dark */
    --hairline: rgba(10, 13, 30, 0.1);
    --hairline-dark: rgba(255, 255, 255, 0.1);
  }

  /* ---------- NAV ---------- */
  .nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    background: rgba(10, 13, 30, 0.9);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--hairline-dark);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 4.25rem; }
  .brand { display: flex; align-items: center; gap: 0.625rem; font-weight: 700; font-size: 1.15rem; color: var(--white); letter-spacing: -0.01em; }
  .brand-dot { width: 12px; height: 12px; border-radius: 3px; background: var(--blue); display: inline-block; }
  .links { display: flex; align-items: center; gap: 1.75rem; font-size: 0.875rem; font-weight: 500; }
  .links a { color: var(--steel); transition: color 0.15s; }
  .links a:hover { color: var(--white); }

  /* ---------- BUTTONS ---------- */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; border-radius: 8px; font-weight: 600; font-size: 0.9375rem; padding: 0.75rem 1.5rem; transition: transform 0.15s, box-shadow 0.2s; }
  .btn:hover { transform: translateY(-2px); }
  .btn-primary { background: var(--blue); color: #fff; box-shadow: 0 6px 20px rgba(47, 75, 255, 0.35); }
  .btn-ghost { border: 1px solid var(--hairline-dark); color: var(--white); }
  .btn-sm { min-height: 2.5rem; padding: 0.4rem 1.25rem; font-size: 0.8125rem; }
  .btn-block { width: 100%; }

  /* ---------- EYEBROWS ---------- */
  .eyebrow, .eyebrow-dark { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem; }
  .eyebrow { color: var(--blue); }
  .eyebrow-dark { color: var(--slate); }
  .rec-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--red); display: inline-block; flex-shrink: 0; animation: recPulse 1.6s ease-in-out infinite; }
  @keyframes recPulse { 0%,100% { opacity: 1; box-shadow: 0 0 0 0 rgba(255,59,48,0.5);} 50% { opacity: 0.55; box-shadow: 0 0 0 6px rgba(255,59,48,0);} }
  .dot-blue { width: 8px; height: 8px; border-radius: 50%; background: var(--blue); display: inline-block; }

  /* ---------- SECTIONS ---------- */
  .section { min-height: 100svh; display: flex; align-items: center; padding-block: 6rem; }
  .section.light { background: var(--white); }
  .section.paper { background: var(--paper); }
  .section.dark { background: var(--ink); }
  .snap-screen { position: relative; }
  h2 { font-size: clamp(2rem, 4.8vw, 3.25rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; color: var(--ink); margin-bottom: 1.25rem; text-wrap: balance; }
  h2.on-dark { color: var(--white); }
  .section-sub { font-size: 1.0625rem; line-height: 1.65; color: var(--slate); margin-bottom: 2.5rem; max-width: 40rem; }
  .on-dark { color: var(--white); }
  .on-dark-muted { color: var(--steel); }
  .label-dark { font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.16em; color: var(--blue); margin-bottom: 0.875rem; }

  /* ---------- HERO ---------- */
  .hero { background: var(--ink); min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding-top: 8rem; padding-bottom: 3rem; position: relative; overflow: hidden; }
  .hero:before { content: ""; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 56px 56px; pointer-events: none; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 4rem; align-items: center; position: relative; }
  .hero h1 { font-size: clamp(2.75rem, 6.8vw, 4.75rem); font-weight: 700; line-height: 1.02; letter-spacing: -0.035em; color: var(--white); text-wrap: balance; }
  .hero h1 .hl-blue { color: var(--blue); }
  .hero-sub { max-width: 34rem; margin-top: 1.5rem; font-size: 1.0625rem; line-height: 1.7; color: var(--steel); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

  /* terminal frame */
  .hero-visual { position: relative; }
  .terminal-frame { border: 1px solid var(--hairline-dark); border-radius: 14px; background: var(--ink-2); overflow: hidden; box-shadow: 0 30px 80px rgba(0,0,0,0.5); }
  .term-bar { display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; border-bottom: 1px solid var(--hairline-dark); }
  .term-title { font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; color: var(--steel); }
  .live { display: inline-flex; align-items: center; gap: 0.4rem; font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.12em; color: var(--red); }
  .term-body { padding: 1.25rem 1.25rem 1rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .term-row { display: flex; align-items: baseline; gap: 0.75rem; font-size: 0.8125rem; }
  .tl { width: 6rem; color: var(--steel); font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .tv { color: var(--white); font-weight: 500; }
  .ok { color: var(--blue); font-weight: 700; }
  .term-barcode { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.75rem 1.25rem; border-top: 1px solid var(--hairline-dark); background: rgba(255,255,255,0.02); }
  .bc-bars { display: inline-block; height: 22px; flex: 1; max-width: 110px; background-image: repeating-linear-gradient(90deg, var(--white) 0 2px, transparent 2px 4px, var(--white) 4px 5px, transparent 5px 9px, var(--white) 9px 12px, transparent 12px 14px); opacity: 0.7; }
  .bc-text { font-family: 'JetBrains Mono', monospace; font-size: 0.625rem; letter-spacing: 0.14em; color: var(--steel); }
  .hero-badge { position: absolute; bottom: -1.25rem; left: -1.25rem; background: var(--white); border-radius: 12px; padding: 0.875rem 1.125rem; display: flex; align-items: center; gap: 0.75rem; box-shadow: 0 16px 40px rgba(0,0,0,0.35); }
  .badge-check { width: 34px; height: 34px; border-radius: 50%; background: var(--blue); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1rem; }
  .hero-badge strong { display: block; font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.06em; }
  .hero-badge small { font-size: 0.6875rem; color: var(--slate); }

  /* stats */
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; width: 100%; max-width: 72rem; margin: 3.5rem auto 0; padding-inline: 1.5rem; border-top: 1px solid var(--hairline-dark); }
  .stat { padding: 1.25rem 1.5rem 0; border-left: 1px solid var(--hairline-dark); }
  .stat:first-child { border-left: none; padding-left: 0; }
  .stat strong { display: block; font-family: 'Space Grotesk', sans-serif; font-size: 1.75rem; font-weight: 700; color: var(--blue); letter-spacing: -0.02em; }
  .stat span { font-size: 0.75rem; color: var(--steel); line-height: 1.45; display: block; margin-top: 0.25rem; }

  /* ---------- WORKFLOW STEPS ---------- */
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 3rem; }
  .step { border: 1px solid var(--hairline); border-radius: 12px; background: var(--white); padding: 1.75rem; position: relative; transition: transform 0.2s, box-shadow 0.2s; }
  .step:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(10,13,30,0.06); }
  .step-num { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; font-weight: 600; color: var(--blue); display: block; margin-bottom: 1rem; }
  .step h3 { font-size: 1.125rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 0.5rem; }
  .step p { font-size: 0.875rem; line-height: 1.6; color: var(--slate); }

