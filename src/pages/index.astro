---
import Base from '../layouts/Base.astro';

const APP_NAME = 'Packory';
const CONSOLE = 'https://console.packory.app';

const CHANNELS = ['Shopee', 'TikTok Shop', 'Lazada', 'Shopify', 'eBay', 'Amazon', 'WhatsApp', 'Google Drive'];

const PILLARS = [
  { key: 'PROOF', title: 'Proof', text: 'Every order leaves with video evidence. No he-said-she-said.' },
  { key: 'SPEED', title: 'Speed', text: 'Hands-free by design. Scan, record, thumbs-up — zero screen touches.' },
  { key: 'TRUST', title: 'Trust', text: 'Buyers see their order being packed before it ships. Disputes lose their fuel.' },
  { key: 'SCALE', title: 'Scale', text: 'One camera or fifty. More orders without more chaos or more disputes.' },
];

const WORKFLOW = [
  { label: 'AWB SCAN', done: true },
  { label: 'RECORD', done: true },
  { label: 'THUMBS-UP', done: true },
  { label: 'SYNC TO DRIVE', done: true },
  { label: 'WHATSAPP LINK', done: true },
  { label: 'BUYER SEES PROOF', done: false },
];

const STATIONS = [
  { name: 'STATION A', detail: 'Packing Line 1', orders: '1,248 orders verified', rate: '100% video coverage', status: 'LIVE' },
  { name: 'STATION B', detail: 'Small Parcels', orders: '864 orders verified', rate: '99.2% sync success', status: 'READY' },
  { name: 'STATION C', detail: 'Bulk / COD', orders: 'Pairing…', rate: 'Action needed', status: 'PAIR' },
];

const METRICS = [
  { label: 'Orders today', value: '1,842', amber: true },
  { label: 'Videos captured', value: '1,840', amber: true },
  { label: 'Evidence links delivered', value: '1,832', amber: true },
  { label: 'Dispute win-rate', value: '98.4%', amber: true },
  { label: 'Sync failures', value: '3', amber: false },
  { label: 'On-time WhatsApp delivery', value: '99.1%', amber: true },
];

const KPI = [
  { value: '100%', label: 'ORDERS ON VIDEO' },
  { value: '0', label: 'VIDEO BYTES ON OUR SERVERS' },
  { value: '<24h', label: 'EVIDENCE ON BUYER’S WHATSAPP' },
  { value: '98.4%', label: 'DISPUTES WON WITH VIDEO' },
];

const FEATURES = [
  {
    title: 'Hands-free video proof',
    text: 'AWB detected automatically. Recording starts by itself and stops on a thumbs-up — packers never touch the screen.',
  },
  {
    title: 'Terrible Wi-Fi? No problem',
    text: 'Clips save to the device instantly and sync to the Admin’s private Google Drive in the background, resuming on reconnect.',
  },
  {
    title: 'Zero server video overhead',
    text: 'Your videos never pass through our servers. Bring-your-own Google Drive storage with a scope-limited token.',
  },
  {
    title: 'Dispute-proof orders',
    text: 'Beat parcel-swap and empty-box claims with timestamped, burned-in packing footage delivered to buyers on WhatsApp.',
  },
];

const PRICING = [
  { name: 'Free', price: 'RM 0', features: ['1 licensed camera', 'Manual WhatsApp links', 'Unlimited packing records'] },
  { name: 'Starter', price: 'RM 49/mo', features: ['2 licensed cameras', 'WhatsApp credits available', 'Weekly sheet automation'] },
  { name: 'Pro', price: 'RM 99/mo', features: ['5 licensed cameras', 'Direct seller channel', 'Priority support'] },
  { name: 'Scale', price: 'RM 199/mo', features: ['15 licensed cameras', 'All channels unlocked', 'Onboarding assistance'] },
];

const TESTIMONIALS = [
  {
    quote: 'We won every parcel-swap dispute last month — every single one had video proof.',
    who: 'Shopee seller, 400+ orders/week',
  },
  {
    quote: 'A buyer claimed the box arrived empty. We sent the packing video. Claim closed in a day.',
    who: 'TikTok Shop seller, Malaysia',
  },
];
---

<Base
  title="Packory — Every order. On video. Dispute-proof."
  description="Packory turns any cheap warehouse Android phone into a hands-free packing verification camera. Every order is recorded with a burned-in timestamp, stored in your own Google Drive, and the evidence link is sent straight to the buyer on WhatsApp."
>
  <header class="nav">
    <div class="container nav-inner">
      <a href="/" class="brand">
        <svg class="logo-mark" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <rect x="1" y="1" width="26" height="26" rx="6" stroke="#E8A33D" stroke-width="2"/>
          <path d="M7 10h8v8H7zM13 16h8v3H13z" stroke="#EBEBED" stroke-width="2" stroke-linejoin="round"/>
          <path d="M11 10V7h7" stroke="#E8A33D" stroke-width="2" stroke-linecap="round"/>
        </svg>
        {APP_NAME}
      </a>
      <nav class="links">
        <a href="#workflow">Product</a>
        <a href="#pricing">Pricing</a>
        <a href={`${CONSOLE}/login`}>Log In</a>
        <a href={`${CONSOLE}/signup`} class="cta">Start Free</a>
      </nav>
    </div>
  </header>

  <!-- 1. HERO -->
  <section class="snap-screen hero">
    <div class="container hero-inner">
      <span class="eyebrow"><span class="dot-amber"></span>PACKING VERIFICATION FOR ECOMMERCE</span>
      <h1>Every order.<br />On video.<br /><span class="accent">Dispute-proof.</span></h1>
      <p class="sub">
        Packory turns any cheap warehouse Android phone into a hands-free packing
        verification camera. Every order is recorded with a burned-in timestamp, stored in
        your own Google Drive, and the evidence link is sent straight to the buyer on WhatsApp.
      </p>
      <div class="actions">
        <a href={`${CONSOLE}/signup`} class="btn-primary">Start free</a>
        <a href="#workflow" class="btn-outline">See how it works</a>
      </div>
      <div class="terminal">
        <div class="term-bar">
          <span class="term-title">packing-terminal · station A</span>
          <span class="live"><span class="pulse"></span>LIVE</span>
        </div>
        <div class="term-body">
          <div class="term-row"><span class="term-label">AWB</span><span class="term-val">123456789012 <span class="ok">✓</span></span></div>
          <div class="term-row"><span class="term-label">Status</span><span class="term-val"><span class="rec"></span> RECORDING — UTC 12:04:31</span></div>
          <div class="term-row"><span class="term-label">Sync</span><span class="term-val">Synced to Drive <span class="ok">✓</span></span></div>
          <div class="term-row"><span class="term-label">WhatsApp</span><span class="term-val">Evidence link sent <span class="ok">✓</span></span></div>
          <div class="term-flow">
            {['SCAN', 'RECORD', 'SYNC', 'SENT'].map((s, i) => (
              <span class="flow-node"><span class="flow-dot"></span>{s}</span>
            ))}
          </div>
        </div>
        <div class="term-barcode" aria-hidden="true">
          <span class="barcode-bars"></span>
          <span class="barcode-text">PKR-0A3F-9C2E-7741</span>
        </div>
      </div>
      <div class="stats">
        <div class="stat"><strong>0</strong><span>video bytes on our servers</span></div>
        <div class="stat"><strong>&lt;100ms</strong><span>UI reset after each order</span></div>
        <div class="stat"><strong>24/7</strong><span>background sync &amp; retry</span></div>
        <div class="stat"><strong>1.5s</strong><span>throttled AWB scan rate</span></div>
      </div>
    </div>
  </section>

  <!-- 2. CHANNELS -->
  <section class="snap-screen section light">
    <div class="container">
      <p class="eyebrow-dark">INTEGRATIONS</p>
      <h2>Prove every order,<br />on every channel.</h2>
      <p class="section-sub">One evidence link, sent to the buyer on WhatsApp — regardless of marketplace.</p>
      <div class="channel-grid">
        {CHANNELS.map((c) => (
          <div class="channel">
            <span class="channel-name">{c}</span>
            <span class="connected"><span class="dot-amber"></span>CONNECTED</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. PROBLEM -->
  <section class="snap-screen section dark">
    <div class="container">
      <p class="eyebrow">THE PROBLEM</p>
      <h2 class="on-dark">More orders shouldn’t<br />mean more disputes.</h2>
      <div class="problem-grid">
        <div class="problem-box">
          <h3 class="label-dark">BEFORE</h3>
          <ul class="chaos">
            <li>Marketplace dispute</li>
            <li>Buyer claim: “empty box”</li>
            <li>Refund forced</li>
            <li>No proof of packing</li>
            <li>Manual WhatsApp threads</li>
          </ul>
        </div>
        <div class="problem-arrow">→</div>
        <div class="problem-box accent">
          <h3 class="label-dark">WITH PACKORY</h3>
          <ul class="calm">
            <li>Automated, timestamped</li>
            <li>Tamper-evident video</li>
            <li>Evidence on WhatsApp</li>
            <li>Dispute fuel removed</li>
            <li class="amber">ONE SYSTEM. EVERY ORDER.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. PILLARS -->
  <section class="snap-screen section light">
    <div class="container">
      <p class="eyebrow-dark">WHY PACKORY</p>
      <h2>Four pillars.<br />One outcome: trust.</h2>
      <div class="pillar-grid">
        {PILLARS.map((p) => (
          <div class="pillar">
            <div class="pillar-key">{p.key}</div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. WORKFLOW -->
  <section id="workflow" class="snap-screen section dark">
    <div class="container">
      <p class="eyebrow">HOW IT WORKS</p>
      <h2 class="on-dark">From AWB scan to evidence sent.<br />Automatically.</h2>
      <div class="workflow">
        {WORKFLOW.map((w, i) => (
          <>
            <div class="wf-step">
              <span class={w.done ? 'wf-dot done' : 'wf-dot'}></span>
              <span class="on-dark wf-label">{w.label}</span>
            </div>
            {i < WORKFLOW.length - 1 && <span class="wf-line"></span>}
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. STATIONS + AUTOMATION -->
  <section class="snap-screen section dark">
    <div class="container">
      <p class="eyebrow">OPERATIONS</p>
      <h2 class="on-dark">Run every packing station<br />from one place.</h2>
      <div class="station-grid">
        {STATIONS.map((s) => (
          <div class="station">
            <div class="station-head">
              <span class="on-dark station-name">{s.name}</span>
              {s.status === 'LIVE' && <span class="status-live"><span class="pulse"></span>LIVE</span>}
              {s.status === 'READY' && <span class="status-ready">READY</span>}
              {s.status === 'PAIR' && <span class="status-pair">PAIRING…</span>}
            </div>
            <div class="station-detail on-dark-muted">{s.detail}</div>
            <div class="station-orders on-dark">{s.orders}</div>
            <div class="station-rate amber">{s.rate}</div>
          </div>
        ))}
      </div>
      <div class="rule">
        <p class="label-dark">AUTOMATE THE REPETITIVE WORK</p>
        <div class="rule-title on-dark">Let the camera do the work.</div>
        <div class="rule-box">
          <div class="rule-line on-dark"><span class="rule-if">IF</span> AWB barcode detected <span class="rule-then">THEN</span> start recording</div>
          <div class="rule-line on-dark"><span class="rule-if">IF</span> thumbs-up detected <span class="rule-then">THEN</span> stop clip, save to device</div>
          <div class="rule-line on-dark"><span class="rule-if">IF</span> upload complete <span class="rule-then">THEN</span> send WhatsApp link to buyer</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. ANALYTICS -->
  <section class="snap-screen section light">
    <div class="container">
      <p class="eyebrow-dark">ANALYTICS</p>
      <h2>See what’s happening before<br />it becomes a claim.</h2>
      <div class="metric-grid">
        {METRICS.map((m) => (
          <div class="metric">
            <div class="metric-value">{m.value}{m.amber && <span class="dot-amber"></span>}</div>
            <div class="metric-label">{m.label}</div>
          </div>
        ))}
      </div>
      <div class="kpi-grid">
        {KPI.map((k) => (
          <div class="kpi">
            <div class="kpi-value">{k.value}</div>
            <div class="kpi-label">{k.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. FEATURES -->
  <section id="features" class="snap-screen section light">
    <div class="container">
      <p class="eyebrow-dark">FEATURES</p>
      <h2>Engineered for hot,<br />noisy warehouses.</h2>
      <div class="feature-grid">
        {FEATURES.map((f) => (
          <div class="feature">
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. PRICING -->
  <section id="pricing" class="snap-screen section light">
    <div class="container">
      <p class="eyebrow-dark">PRICING</p>
      <h2>Pay per camera.</h2>
      <p class="section-sub">One license per device. Paid securely via MYR FPX, cards, or local e-wallets.</p>
      <div class="pricing-grid">
        {PRICING.map((p) => (
          <div class="price-card">
            <div class="price-name">{p.name}</div>
            <div class="price-value">{p.price}</div>
            <ul>
              {p.features.map((f) => (
                <li><span class="li-check">✓</span> {f}</li>
              ))}
            </ul>
            <a href={`${CONSOLE}/signup`} class="btn-price">Get started</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. TESTIMONIALS + FINAL CTA -->
  <section class="snap-screen section dark">
    <div class="container">
      <p class="eyebrow">CUSTOMERS</p>
      <h2 class="on-dark">Built for sellers who can’t afford<br />another empty-box claim.</h2>
      <div class="testimonial-grid">
        {TESTIMONIALS.map((t) => (
          <div class="testimonial">
            <p class="on-dark quote">“{t.quote}”</p>
            <div class="testimonial-who amber">{t.who}</div>
          </div>
        ))}
      </div>
      <div class="final-cta">
        <h3 class="on-dark">Ready to put your orders<br />on the record?</h3>
        <p class="on-dark-muted">Turn any Android phone into a hands-free packing verification camera. Free to start. Your videos stay in your own Google Drive.</p>
        <div class="actions">
          <a href={`${CONSOLE}/signup`} class="btn-primary">Start free</a>
          <a href={`${CONSOLE}/login`} class="btn-outline">Book a demo</a>
        </div>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="container footer-inner">
      <span>© {new Date().getFullYear()} {APP_NAME}</span>
      <span>Built for Malaysian e-commerce merchants 🇲🇾</span>
    </div>
  </footer>
</Base>

<style>
  /* ===== DESIGN TOKENS — Black + Amber (tech trust × shipping) ===== */
  :root {
    --ink: #0f1417;          /* carbon black — foundation */
    --ink-deep: #0a0d0f;
    --ink-soft: #1a2025;
    --paper: #ebebed;        /* soft gray — light sections */
    --paper-bright: #f5f5f4;
    --amber: #e8a33d;        /* shipping accent — CTA, live, checks */
    --amber-bright: #f2b44d;
    --steel: #9aa3ad;        /* muted on dark */
    --slate: #5b6470;        /* muted on light */
    --hairline: rgba(235, 235, 237, 0.1);
    --hairline-dark: rgba(15, 20, 23, 0.12);
  }

  /* ---------- NAV ---------- */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: rgba(10, 13, 15, 0.85);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--hairline);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--paper-bright);
    letter-spacing: -0.01em;
  }

  .logo-mark {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .links a {
    color: var(--steel);
    transition: color 0.15s;
  }

  .links a:hover {
    color: var(--paper-bright);
  }

  .links .cta {
    background: var(--amber);
    color: var(--ink);
    border-radius: 9999px;
    padding: 0.5rem 1.25rem;
    font-weight: 600;
  }

  /* ---------- BASE SECTIONS ---------- */
  .section {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: 6rem;
  }

  .section.light {
    background: var(--paper);
  }

  .section.dark {
    background: var(--ink-deep);
  }

  h2 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--ink);
    margin-bottom: 1.25rem;
    text-wrap: balance;
  }

  h2.on-dark {
    color: var(--paper-bright);
  }

  .section-sub {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--slate);
    margin-bottom: 2.75rem;
    max-width: 40rem;
  }

  .eyebrow, .eyebrow-dark {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .eyebrow {
    color: var(--amber);
  }

  .eyebrow-dark {
    color: var(--slate);
  }

  .label-dark {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--slate);
    margin-bottom: 0.875rem;
  }

  .dot-amber {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--amber);
    display: inline-block;
    flex-shrink: 0;
  }

  .amber {
    color: var(--amber) !important;
  }

  .on-dark {
    color: var(--paper-bright);
  }

  .on-dark-muted {
    color: var(--steel);
  }

  /* ---------- HERO ---------- */
  .hero {
    background: var(--ink-deep);
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: 7rem;
    padding-bottom: 4rem;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(2.75rem, 8vw, 5.25rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--paper-bright);
    text-wrap: balance;
  }

  .hero h1 .accent {
    color: var(--amber);
  }

  .hero .sub {
    max-width: 42rem;
    margin-top: 1.5rem;
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.7;
    color: var(--steel);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .btn-primary {
    background: var(--amber);
    color: var(--ink);
    border-radius: 9999px;
    padding: 0.8125rem 1.75rem;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .btn-outline {
    border: 1px solid var(--hairline);
    color: var(--paper-bright);
    border-radius: 9999px;
    padding: 0.8125rem 1.75rem;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  /* Terminal mockup */
  .terminal {
    width: 100%;
    max-width: 34rem;
    margin-top: 3rem;
    border: 1px solid var(--hairline);
    border-radius: 12px;
    background: #0d1215;
    overflow: hidden;
    text-align: left;
  }

  .term-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--hairline);
  }

  .term-title {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.6875rem;
    color: var(--steel);
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--amber);
  }

  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--amber);
    animation: pulse 1.6s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(232, 163, 61, 0.5); }
    50% { opacity: 0.55; box-shadow: 0 0 0 6px rgba(232, 163, 61, 0); }
  }

  .term-body {
    padding: 1rem 1.125rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .term-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.8125rem;
  }

  .term-label {
    width: 6rem;
    color: var(--steel);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .term-val {
    color: var(--paper-bright);
    font-weight: 500;
  }

  .ok {
    color: var(--amber);
    font-weight: 700;
  }

  .rec {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--amber);
    animation: pulse 1.6s ease-in-out infinite;
  }

  .term-flow {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--hairline);
    flex-wrap: wrap;
  }

  .flow-node {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--paper-bright);
  }

  .flow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber);
  }

  /* Barcode */
  .term-barcode {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 1.125rem;
