---
import Base from '../layouts/Base.astro';

const APP_NAME = 'Packory';
const CONSOLE = 'https://console.packory.app';

const CHANNELS = ['Shopee', 'TikTok Shop', 'Lazada', 'Shopify', 'eBay', 'Amazon', 'WhatsApp', 'Google Drive'];

const PILLARS = [
  { key: '01', title: 'PROOF', text: 'Every order leaves with video evidence. No he-said-she-said.' },
  { key: '02', title: 'SPEED', text: 'Hands-free by design. Scan, record, thumbs-up — zero screen touches.' },
  { key: '03', title: 'TRUST', text: 'Buyers see their order being packed before it ships. Disputes lose their fuel.' },
  { key: '04', title: 'SCALE', text: 'One camera or fifty. More orders without more chaos or more disputes.' },
];

const WORKFLOW = [
  { label: 'AWB SCAN', done: true },
  { label: 'RECORD', done: true },
  { label: 'THUMBS-UP', done: true },
  { label: 'SYNC TO DRIVE', done: true },
  { label: 'WHATSAPP LINK', done: true },
  { label: 'BUYER SEES PROOF', done: false },
];

const STATIONS = [
  { name: 'STATION A', detail: 'Packing Line 1', orders: '1,248 orders verified', rate: '100% video coverage', status: 'LIVE' },
  { name: 'STATION B', detail: 'Small Parcels', orders: '864 orders verified', rate: '99.2% sync success', status: 'READY' },
  { name: 'STATION C', detail: 'Bulk / COD', orders: 'Pairing…', rate: 'Action needed', status: 'PAIR' },
];

const METRICS = [
  { label: 'Orders today', value: '1,842' },
  { label: 'Videos captured', value: '1,840' },
  { label: 'Evidence links delivered', value: '1,832' },
  { label: 'Dispute win-rate', value: '98.4%' },
  { label: 'Sync failures', value: '3' },
  { label: 'On-time WhatsApp delivery', value: '99.1%' },
];

const KPI = [
  { value: '100%', label: 'ORDERS ON VIDEO' },
  { value: '0', label: 'VIDEO BYTES ON OUR SERVERS' },
  { value: '<24H', label: 'EVIDENCE ON BUYER’S WHATSAPP' },
  { value: '98.4%', label: 'DISPUTES WON WITH VIDEO' },
];

const FEATURES = [
  {
    title: 'HANDS-FREE VIDEO PROOF',
    text: 'AWB detected automatically. Recording starts by itself and stops on a thumbs-up — packers never touch the screen.',
  },
  {
    title: 'TERRIBLE WI-FI? NO PROBLEM',
    text: 'Clips save to the device instantly and sync to the Admin’s private Google Drive in the background, resuming on reconnect.',
  },
  {
    title: 'ZERO SERVER VIDEO OVERHEAD',
    text: 'Your videos never pass through our servers. Bring-your-own Google Drive storage with a scope-limited token.',
  },
  {
    title: 'DISPUTE-PROOF ORDERS',
    text: 'Beat parcel-swap and empty-box claims with timestamped, burned-in packing footage delivered to buyers on WhatsApp.',
  },
];

const PRICING = [
  { name: 'FREE', price: 'RM 0', features: ['1 licensed camera', 'Manual WhatsApp links', 'Unlimited packing records'] },
  { name: 'STARTER', price: 'RM 49/mo', features: ['2 licensed cameras', 'WhatsApp credits available', 'Weekly sheet automation'] },
  { name: 'PRO', price: 'RM 99/mo', features: ['5 licensed cameras', 'Direct seller channel', 'Priority support'] },
  { name: 'SCALE', price: 'RM 199/mo', features: ['15 licensed cameras', 'All channels unlocked', 'Onboarding assistance'] },
];

const TESTIMONIALS = [
  {
    quote: 'We won every parcel-swap dispute last month — every single one had video proof.',
    who: 'SHOPEE SELLER · 400+ ORDERS/WEEK',
  },
  {
    quote: 'A buyer claimed the box arrived empty. We sent the packing video. Claim closed in a day.',
    who: 'TIKTOK SHOP SELLER · MALAYSIA',
  },
];
---

<Base
  title="Packory — Every order. On video. Dispute-proof."
  description="Packory turns any cheap warehouse Android phone into a hands-free packing verification camera. Every order is recorded with a burned-in timestamp, stored in your own Google Drive, and the evidence link is sent straight to the buyer on WhatsApp."
>
  <header class="nav">
    <div class="container nav-inner">
      <a href="/" class="brand">
        <span class="logo-box"></span>
        {APP_NAME}
      </a>
      <nav class="links">
        <a href="#workflow">PRODUCT</a>
        <a href="#pricing">PRICING</a>
        <a href={`${CONSOLE}/login`}>LOG IN</a>
        <a href={`${CONSOLE}/signup`} class="cta">START FREE</a>
      </nav>
    </div>
  </header>

  <!-- 1. HERO -->
  <section class="snap-screen hero">
    <div class="hero-side" aria-hidden="true">
      <span class="side-num">01</span>
      <span class="side-line"></span>
      <span class="side-meta">PKR·EST·2026</span>
    </div>
    <div class="container hero-main">
      <span class="tag"><span class="dot"></span>PACKING VERIFICATION FOR ECOMMERCE</span>
      <h1 class="display">
        <span class="circle-word"><span class="word-circle orange">EVERY</span> ORDER.</span><br />
        <span class="circle-word"><span class="word-circle teal">ON</span> VIDEO.</span><br />
        <span class="accent">DISPUTE-PROOF.</span>
      </h1>
      <div class="hero-grid">
        <p class="sub">
          Packory turns any cheap warehouse Android phone into a hands-free packing
          verification camera. Every order is recorded with a burned-in timestamp, stored in
          your own Google Drive, and the evidence link is sent straight to the buyer on WhatsApp.
        </p>
        <div class="actions">
          <a href={`${CONSOLE}/signup`} class="btn-primary">START FREE</a>
          <a href="#workflow" class="btn-outline">SEE HOW IT WORKS</a>
        </div>
      </div>
      <div class="terminal">
        <div class="term-bar">
          <span class="term-title">PACKING-TERMINAL · STATION A</span>
          <span class="live"><span class="pulse"></span>LIVE</span>
        </div>
        <div class="term-body">
          <div class="term-row"><span class="term-label">AWB</span><span class="term-val">123456789012 <span class="ok">✓</span></span></div>
          <div class="term-row"><span class="term-label">STATUS</span><span class="term-val"><span class="rec"></span> RECORDING — UTC 12:04:31</span></div>
          <div class="term-row"><span class="term-label">SYNC</span><span class="term-val">SYNCED TO DRIVE <span class="ok">✓</span></span></div>
          <div class="term-row"><span class="term-label">WHATSAPP</span><span class="term-val">EVIDENCE LINK SENT <span class="ok">✓</span></span></div>
        </div>
      </div>
      <div class="stats">
        <div class="stat"><strong>0</strong><span>VIDEO BYTES ON OUR SERVERS</span></div>
        <div class="stat"><strong>&lt;100MS</strong><span>UI RESET AFTER EACH ORDER</span></div>
        <div class="stat"><strong>24/7</strong><span>BACKGROUND SYNC &amp; RETRY</span></div>
        <div class="stat"><strong>1.5S</strong><span>THROTTLED AWB SCAN RATE</span></div>
      </div>
    </div>
  </section>

  <!-- 2. CHANNELS -->
  <section class="snap-screen section teal">
    <div class="section-side" aria-hidden="true">
      <span class="side-num">02</span>
      <span class="side-line"></span>
    </div>
    <div class="container">
      <span class="tag-dark">INTEGRATIONS</span>
      <h2 class="display">PROVE EVERY ORDER.<br />ON EVERY CHANNEL.</h2>
      <p class="sub-dark">One evidence link, sent to the buyer on WhatsApp — regardless of marketplace.</p>
      <div class="channel-grid">
        {CHANNELS.map((c) => (
          <div class="channel">
            <span>{c}</span>
            <span class="connected"><span class="dot"></span>CONNECTED</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. PROBLEM -->
  <section class="snap-screen section orange">
    <div class="section-side" aria-hidden="true">
      <span class="side-num">03</span>
      <span class="side-line"></span>
    </div>
    <div class="container">
      <span class="tag-dark">THE PROBLEM</span>
      <h2 class="display">MORE ORDERS SHOULDN’T<br />MEAN MORE DISPUTES.</h2>
      <div class="problem-grid">
        <div class="problem-box">
          <h3 class="meta">BEFORE</h3>
          <ul class="chaos">
            <li>Marketplace dispute</li>
            <li>Buyer claim: “empty box”</li>
            <li>Refund forced</li>
            <li>No proof of packing</li>
            <li>Manual WhatsApp threads</li>
          </ul>
        </div>
        <div class="problem-arrow">→</div>
        <div class="problem-box dark-box">
          <h3 class="meta-light">WITH PACKORY</h3>
          <ul class="calm">
            <li>Automated, timestamped</li>
            <li>Tamper-evident video</li>
            <li>Evidence on WhatsApp</li>
            <li>Dispute fuel removed</li>
            <li class="strong">ONE SYSTEM. EVERY ORDER.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. PILLARS -->
  <section class="snap-screen section white">
    <div class="section-side" aria-hidden="true">
      <span class="side-num">04</span>
      <span class="side-line"></span>
    </div>
    <div class="container">
      <span class="tag">WHY PACKORY</span>
      <h2 class="display">FOUR PILLARS.<br />ONE OUTCOME: TRUST.</h2>
      <div class="pillar-grid">
        {PILLARS.map((p, i) => (
          <div class={`pillar pillar-${i % 4}`}>
            <div class="pillar-key">{p.key}</div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. WORKFLOW -->
  <section id="workflow" class="snap-screen section charcoal">
    <div class="section-side" aria-hidden="true">
      <span class="side-num">05</span>
      <span class="side-line"></span>
    </div>
    <div class="container">
      <span class="tag-light">HOW IT WORKS</span>
      <h2 class="display on-dark">FROM AWB SCAN TO<br />EVIDENCE SENT. AUTOMATICALLY.</h2>
      <div class="workflow">
        {WORKFLOW.map((w, i) => (
          <>
            <div class="wf-step">
              <span class={w.done ? 'wf-dot done' : 'wf-dot'}></span>
              <span class="wf-label">{w.label}</span>
            </div>
            {i < WORKFLOW.length - 1 && <span class="wf-line"></span>}
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. STATIONS + AUTOMATION -->
  <section class="snap-screen section teal">
    <div class="section-side" aria-hidden="true">
      <span class="side-num">06</span>
      <span class="side-line"></span>
    </div>
    <div class="container">
      <span class="tag-dark">OPERATIONS</span>
      <h2 class="display">RUN EVERY PACKING STATION<br />FROM ONE PLACE.</h2>
      <div class="station-grid">
        {STATIONS.map((s) => (
          <div class="station">
            <div class="station-head">
              <span class="station-name">{s.name}</span>
              {s.status === 'LIVE' && <span class="status-live"><span class="pulse"></span>LIVE</span>}
              {s.status === 'READY' && <span class="status-ready">READY</span>}
              {s.status === 'PAIR' && <span class="status-pair">PAIRING…</span>}
            </div>
            <div class="station-detail">{s.detail}</div>
            <div class="station-orders">{s.orders}</div>
            <div class="station-rate">{s.rate}</div>
          </div>
        ))}
      </div>
      <div class="rule">
        <p class="meta">AUTOMATE THE REPETITIVE WORK</p>
        <div class="rule-title">LET THE CAMERA DO THE WORK.</div>
        <div class="rule-box">
          <div class="rule-line"><span class="rule-if">IF</span> AWB barcode detected <span class="rule-then">THEN</span> start recording</div>
          <div class="rule-line"><span class="rule-if">IF</span> thumbs-up detected <span class="rule-then">THEN</span> stop clip, save to device</div>
          <div class="rule-line"><span class="rule-if">IF</span> upload complete <span class="rule-then">THEN</span> send WhatsApp link to buyer</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. ANALYTICS -->
  <section class="snap-screen section orange">
    <div class="section-side" aria-hidden="true">
      <span class="side-num">07</span>
      <span class="side-line"></span>
    </div>
    <div class="container">
      <span class="tag-dark">ANALYTICS</span>
      <h2 class="display">SEE WHAT’S HAPPENING BEFORE<br />IT BECOMES A CLAIM.</h2>
      <div class="metric-grid">
        {METRICS.map((m) => (
          <div class="metric">
            <div class="metric-value">{m.value}</div>
            <div class="metric-label">{m.label}</div>
          </div>
        ))}
      </div>
      <div class="kpi-grid">
        {KPI.map((k) => (
          <div class="kpi">
            <div class="kpi-value">{k.value}</div>
            <div class="kpi-label">{k.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. FEATURES -->
  <section id="features" class="snap-screen section white">
    <div class="section-side" aria-hidden="true">
      <span class="side-num">08</span>
      <span class="side-line"></span>
    </div>
    <div class="container">
      <span class="tag">FEATURES</span>
      <h2 class="display">ENGINEERED FOR HOT,<br />NOISY WAREHOUSES.</h2>
      <div class="feature-grid">
        {FEATURES.map((f, i) => (
          <div class={`feature feature-${i % 2}`}>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. PRICING -->
  <section id="pricing" class="snap-screen section peach">
    <div class="section-side" aria-hidden="true">
      <span class="side-num">09</span>
      <span class="side-line"></span>
    </div>
    <div class="container">
      <span class="tag">PRICING</span>
      <h2 class="display">PAY PER CAMERA.</h2>
      <p class="sub">One license per device. Paid securely via MYR FPX, cards, or local e-wallets.</p>
      <div class="pricing-grid">
        {PRICING.map((p, i) => (
          <div class={`price-card price-${i % 2}`}>
            <div class="price-name">{p.name}</div>
            <div class="price-value">{p.price}</div>
            <ul>
              {p.features.map((f) => (
                <li><span class="li-check">✓</span> {f}</li>
              ))}
            </ul>
            <a href={`${CONSOLE}/signup`} class="btn-price">GET STARTED</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. TESTIMONIALS + FINAL CTA -->
  <section class="snap-screen section charcoal">
    <div class="section-side" aria-hidden="true">
      <span class="side-num">10</span>
      <span class="side-line"></span>
    </div>
    <div class="container">
      <span class="tag-light">CUSTOMERS</span>
      <h2 class="display on-dark">BUILT FOR SELLERS WHO CAN’T<br />AFFORD ANOTHER EMPTY-BOX CLAIM.</h2>
      <div class="testimonial-grid">
        {TESTIMONIALS.map((t) => (
          <div class="testimonial">
            <p class="quote">“{t.quote}”</p>
            <div class="testimonial-who">{t.who}</div>
          </div>
        ))}
      </div>
      <div class="final-cta">
        <h3 class="display on-dark">READY TO PUT YOUR ORDERS<br />ON THE RECORD?</h3>
        <p class="on-dark-muted">Turn any Android phone into a hands-free packing verification camera. Free to start. Your videos stay in your own Google Drive.</p>
        <div class="actions">
          <a href={`${CONSOLE}/signup`} class="btn-primary">START FREE</a>
          <a href={`${CONSOLE}/login`} class="btn-outline-light">BOOK A DEMO</a>
        </div>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="container footer-inner">
      <span>© {new Date().getFullYear()} {APP_NAME}</span>
      <span>BUILT FOR MALAYSIAN E-COMMERCE MERCHANTS 🇲🇾</span>
    </div>
  </footer>
</Base>

<style>
  /* ===== RETRO EDITORIAL SYSTEM — orange / teal / white / charcoal ===== */
  :root {
    --orange: #fd8405;
    --burnt: #e45507;
    --tangerine: #f89437;
    --teal: #13b9b6;
    --white: #fefefd;
    --charcoal: #341c19;
    --grey: #bfd1ce;
    --peach: #f2b279;
    --line: rgba(52, 28, 25, 0.18);
    --line-light: rgba(254, 254, 253, 0.25);
  }

  /* ---------- NAV ---------- */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--charcoal);
    border-bottom: 1px solid var(--line-light);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-weight: 800;
    font-size: 1.125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--white);
  }

  .logo-box {
    width: 14px;
    height: 14px;
    background: var(--orange);
    display: inline-block;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .links a {
    color: var(--white);
    opacity: 0.75;
    transition: opacity 0.15s;
  }

  .links a:hover {
    opacity: 1;
  }

  .links .cta {
    background: var(--orange);
    color: var(--charcoal);
    border-radius: 0;
    padding: 0.5rem 1.25rem;
    font-weight: 800;
    opacity: 1;
  }

  /* ---------- SIDE COLUMN (editorial) ---------- */
  .hero-side, .section-side {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 3.5rem;
    flex-shrink: 0;
    padding-top: 1rem;
    border-right: 1px solid var(--line-light);
  }

  .section-side {
    border-right: 1px solid var(--line);
  }

  .side-num {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--white);
    opacity: 0.6;
  }

  .section-side .side-num {
    color: var(--charcoal);
  }

  .side-line {
    width: 1px;
    flex: 1;
    background: var(--line-light);
    min-height: 3rem;
  }

  .section-side .side-line {
    background: var(--line);
  }

  .side-meta {
    writing-mode: vertical-rl;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--white);
    opacity: 0.5;
    padding-bottom: 1rem;
  }

  /* ---------- BASE ---------- */
  .section {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: 6rem;
    position: relative;
  }

  .section.teal { background: var(--teal); }
  .section.orange { background: var(--orange); }
  .section.white { background: var(--white); }
  .section.charcoal { background: var(--charcoal); }
  .section.peach { background: var(--peach); }

  .display {
    font-size: clamp(2rem, 5.5vw, 3.75rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1.02;
    color: var(--charcoal);
    margin-bottom: 1.5rem;
    text-wrap: balance;
  }

  .on-dark {
    color: var(--white);
  }

  /* tag */
  .tag, .tag-dark, .tag-light {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .tag { color: var(--teal); }
  .tag-dark { color: var(--charcoal); }
  .tag-light { color: var(--orange); }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--orange);
    display: inline-block;
  }

  .tag-dark .dot { background: var(--charcoal); }
  .tag-light .dot { background: var(--orange); }

  /* sub */
  .sub, .sub-dark {
    font-size: 1.0625rem;
    line-height: 1.65;
    max-width: 40rem;
    margin-bottom: 2.5rem;
  }

  .sub { color: var(--charcoal); }
  .sub-dark { color: var(--charcoal); }

  .meta, .meta-light {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    margin-bottom: 0.875rem;
  }

  .meta { color: var(--charcoal); }
  .meta-light { color: var(--white); opacity: 0.7; }

  .strong { font-weight: 800; color: var(--charcoal); }

  /* ---------- HERO ---------- */
  .hero {
    background: var(--charcoal);
    min-height: 100svh;
    display: flex;
    padding-top: 6.5rem;
    padding-bottom: 4rem;
  }

  .hero-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    width: 100%;
    padding-left: 1.5rem;
  }

  .hero .display {
    color: var(--white);
    font-size: clamp(2.5rem, 7.5vw, 5rem);
  }

  .hero .accent {
    color: var(--orange);
  }

  .circle-word {
    display: inline-flex;
    align-items: center;
    position: relative;
  }

  .word-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    padding: 0.15em 0.3em;
    margin-right: 0.2em;
    font-weight: 900;
  }

  .word-circle.orange { background: var(--orange); color: var(--charcoal); }
  .word-circle.teal { background: var(--teal); color: var(--white); }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: end;
    width: 100%;
    margin-top: 1rem;
  }

  .hero .sub {
    color: var(--grey);
    margin-bottom: 0;
    max-width: 34rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  .btn-primary {
    background: var(--orange);
    color: var(--charcoal);
    border-radius: 0;
    padding: 0.75rem 1.5rem;
    font-weight: 800;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .btn-outline {
    border: 1px solid var(--line-light);
    color: var(--white);
    border-radius: 0;
    padding: 0.75rem 1.5rem;
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .btn-outline-light {
    border: 1px solid var(--line-light);
    color: var(--white);
    border-radius: 0;
    padding: 0.75rem 1.5rem;
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Terminal */
  .terminal {
    width: 100%;
