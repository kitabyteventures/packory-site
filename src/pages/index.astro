---
import Base from '../layouts/Base.astro';

const CONSOLE = 'https://console.packory.app';

const FAQS = [
  { q: 'I already record packing with my phone. Why Packory?', a: 'A raw clip in your phone gallery has no link to the order — weeks later you cannot find it, and you cannot prove when it was shot. Packory files every clip under its AWB in your own Drive with a UTC timestamp, and sends the buyer a clean proof link automatically. Evidence you can actually find and send when a claim lands.' },
  { q: "Where are the videos stored? I don't want my footage on someone's server.", a: "In your own Google Drive. Packory sets up the upload — we never keep your videos on our servers." },
  { q: 'My shop Wi-Fi is really bad. Will this still work?', a: "Yes. Clips save to the phone first and sync in the background whenever there's a connection. Drop out? It picks up where it left off." },
  { q: 'Does the packer have to press anything for every order?', a: 'No. The AWB scan starts recording and the thumbs-up stops it — no screen touches, no workflow interruption.' },
  { q: 'Will this actually help in a Shopee or TikTok dispute?', a: 'When a dispute opens, platforms ask for evidence. Timestamped footage showing the item packed and handed over is the strongest reply a seller can send — video does not guarantee an outcome, but arguing without it is far harder.' },
  { q: 'How does the free plan work?', a: 'Up to 50 verified orders a month, free. Need more? Upgrade anytime — and downgrade again if you want.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Packing Verification for E-commerce Sellers (Malaysia) | Packory"
  description="Every order gets its own video proof. Packory records hands-free packing video with timestamps, saves it to your own Google Drive and sends buyers the proof link on WhatsApp — dispute-proof, automatically."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="banner">Beta is open — Malaysian sellers get <a href="#">founding pricing</a></div>

  <nav>
    <div class="wrap nav-inner">
      <a class="brand" href="#top"><span class="dot"></span>Packory</a>
      <div class="nav-links">
        <a href="#why">Why Packory</a>
        <a href="#how">How it works</a>
        <a href="#pricing">Pricing</a>
        <a href="#faq">FAQ</a>
        <a href="/blog">Blog</a>
        <a class="btn btn-blue btn-sm cta" href={`${CONSOLE}/signup`}>Start Free</a>
      </div>
    </div>
  </nav>

  <header class="hero" id="top">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="pill"><span class="dot red"></span> For Shopee · TikTok Shop · Lazada sellers</span>
        <h1>Every order gets its own <span class="accent">video proof</span>. <span class="u">Easy as that.</span></h1>
        <p class="hero-sub">When you pack, Packory records automatically — timestamped, saved to <b>your own Google Drive</b>, proof link on the buyer's WhatsApp. A dispute shows up? Send the video.</p>
        <form class="lead-form" id="lead-form" novalidate>
          <input type="tel" inputmode="tel" autocomplete="tel" placeholder="Your WhatsApp number" aria-label="Your WhatsApp number" />
          <button class="btn btn-white" type="submit">Start Free</button>
          <span class="lead-err" id="lead-err" hidden>Enter a valid Malaysian WhatsApp number, e.g. 012-3456789</span>
        </form>
        <p class="consent-line">By continuing, you agree to be contacted on WhatsApp about your Packory setup. <a href="#">Privacy Policy</a></p>
        <p class="micro"><span>✓ Free for 50 orders a month</span><span>✓ No credit card</span><span>✓ Set up in minutes</span></p>
      </div>
      <div class="hero-visual">
        <div class="white-card">
          <img src="/hero-illustration-blue.webp" srcset="/hero-illustration-blue-640.webp 640w, /hero-illustration-blue.webp 1100w" sizes="(max-width: 640px) 92vw, 540px" width="1100" height="1100" alt="Seller packing an order while a phone on a tripod records — proof captured automatically" fetchpriority="high" />
        </div>
      </div>
    </div>
  </header>

  <div class="logos">
    <div class="wrap">
      <p class="cap">Sell on any marketplace or store — ship with any courier. One proof link, everywhere.</p>
      <div class="logo-rows">
        <div class="logo-row-wrap">
          <div class="logo-row" id="row1"></div>
        </div>
        <div class="logo-row-wrap rev">
          <div class="logo-row" id="row2"></div>
        </div>
        <div class="logo-row-wrap">
          <div class="logo-row" id="row3"></div>
        </div>
      </div>
    </div>
  </div>

  <section class="pains" id="why">
    <div class="wrap center">
      <span class="kicker">The problem</span>
      <h2>Disputes are decided on evidence.<br />Most sellers don't have it.</h2>
      <p class="sub">Claims like these eat into your margin and your time. Without a record of what you packed, arguing is hard — and refunding is easy.</p>
      <div class="pain-grid">
        <div class="pain">
          <span class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg></span>
          <h3>"The box arrived empty"</h3>
          <p>A buyer says the parcel came empty. You know you packed it right — but without video, it's your word against theirs.</p>
        </div>
        <div class="pain">
          <span class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/></svg></span>
          <h3>"That's not what I ordered"</h3>
          <p>Wrong-item and parcel-swap claims come back to you. Refund issued, item not returned, and the seller rating takes a hit.</p>
        </div>
        <div class="pain">
          <span class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
          <h3>No time to film every order</h3>
          <p>Orders are piling up. Nobody stops to record one by one — until the day you really wish you had.</p>
        </div>
      </div>
      <p class="flip"><span>That's why Packory exists.</span></p>
    </div>
  </section>

  <section id="how">
    <div class="wrap center">
      <span class="kicker">How it works</span>
      <h2>You just pack. We capture the proof.</h2>
      <p class="sub">A video record of every order — automatic, hands-free, timestamped at capture. No new workflow.</p>
      <div class="steps-grid">
        <div class="step-card" data-i="0">
          <span class="num">01</span>
          <h3><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/></svg>Scan the AWB</h3>
          <p>The barcode is detected and recording starts by itself — one scan every 1.5 seconds.</p>
        </div>
        <div class="step-card" data-i="1">
          <span class="num">02</span>
          <h3><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 8-6 4 6 4V8Z"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg>Pack on camera</h3>
          <p>Every item goes into the box on video, with a UTC timestamp burned into the frame.</p>
        </div>
        <div class="step-card" data-i="2">
          <span class="num">03</span>
          <h3><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 11v8a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-7a1 1 0 0 1 .3-.7L6 8"/><path d="M14 4h1.5A2.5 2.5 0 0 1 18 6.5V9"/><path d="M14 20h2a2 2 0 0 0 2-2V9"/><path d="M18 9a4 4 0 0 0-8 0"/><path d="M12 9v11"/></svg>Thumbs-up</h3>
          <p>Done? Give a thumbs-up to the camera — the clip stops and files itself under the order in your Drive.</p>
        </div>
        <div class="step-card" data-i="3">
          <span class="num">04</span>
          <h3><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5c-1.5 0-3-.4-4.2-1L3 20l1-5.3a8.4 8.4 0 1 1 17-3.2Z"/><path d="m9 11 2 2 4-4"/></svg>Buyer sees proof</h3>
          <p>The evidence link lands on the buyer's WhatsApp — before the parcel even ships.</p>
        </div>
      </div>
      <div class="step-note">
        <span class="tip-ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.4 1 2.3h6c0-.9.4-1.8 1-2.3A7 7 0 0 0 12 2Z"/></svg></span>
        <p><b>Two habits that save you later:</b> don't record only the expensive orders — the claims that hurt most come from the ones you least expected. And don't rely on your phone gallery either: a raw video with no order link is almost impossible to find when a dispute lands. Packory files every clip under its AWB, so proof is seconds away.</p>
      </div>
    </div>
  </section>

  <section class="benefits">
    <div class="wrap center">
      <span class="kicker">Built for the real shop floor</span>
      <h2>Proof you can stand behind</h2>
      <p class="sub">Evidence only helps if it survives scrutiny. Every Packory clip is timestamped at capture, stored on your own Drive, and linked to its order.</p>
      <div class="ben">
        <div class="ben-card">
          <span class="ic b"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13a10 10 0 0 1 14 0"/><path d="M8.5 16.5a5 5 0 0 1 7 0"/><path d="M2 8.82a15 15 0 0 1 20 0"/><path d="M12 20h.01"/></svg></span>
          <h3>Terrible Wi-Fi? Fine.</h3>
          <p>Clips save to the phone first, then sync to Drive in the background — and reconnect automatically if it drops.</p>
        </div>
        <div class="ben-card">
          <span class="ic c"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
          <h3>Your videos, your hands</h3>
          <p>Zero video on our servers. Everything lives in your Google Drive — private, with no hidden storage fees.</p>
        </div>
        <div class="ben-card">
          <span class="ic b"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg></span>
          <h3>A cheap phone is enough</h3>
          <p>That dusty old Android in the drawer becomes a proof camera. No new hardware to buy.</p>
        </div>
        <div class="ben-card">
          <span class="ic c"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/><path d="M8 12h.01M12 12h.01M16 12h.01"/></svg></span>
          <h3>Buyers see it themselves</h3>
          <p>A clean WhatsApp link — buyers watch their own order being packed properly. Trust goes up, disputes lose their fuel.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="pricing">
    <div class="wrap center">
      <span class="kicker">Pricing</span>
      <h2>Pay by how many orders you verify</h2>
      <p class="sub">Every plan includes hands-free video proof and WhatsApp evidence links. Start free — upgrade when your orders grow.</p>
      <div class="price-grid">
        <div class="price">
          <div class="pname">Proof <em>· Free</em></div>
          <div class="val">RM0 <small>/month</small></div>
          <ul>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>50 verified orders a month</li>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Hands-free packing video</li>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>WhatsApp evidence link</li>
          </ul>
          <a class="btn btn-ghost" href={`${CONSOLE}/signup`}>Start Free</a>
        </div>
        <div class="price">
          <div class="pname">Verified <em>· RM49</em></div>
          <div class="val">RM49 <small>/month</small></div>
          <ul>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>300 verified orders a month</li>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Everything in Proof</li>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>For growing sellers</li>
          </ul>
          <a class="btn btn-ghost" href={`${CONSOLE}/signup`}>Choose Verified</a>
        </div>
        <div class="price pop" id="pop-tier">
          <span class="pop-badge">Most popular</span>
          <div class="pname">Verified Seller <em>· RM99</em></div>
          <div class="val">RM99 <small>/month</small></div>
          <ul>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>600 verified orders a month</li>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Everything in Verified</li>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>For busy daily sellers</li>
          </ul>
          <a class="btn btn-blue" href={`${CONSOLE}/signup`}>Choose Verified Seller</a>
        </div>
        <div class="price">
          <div class="pname">Dispute-Proof <em>· RM199</em></div>
          <div class="val">RM199 <small>/month</small></div>
          <ul>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>1,500+ verified orders a month</li>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Everything in Verified Seller</li>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>For bigger operations</li>
          </ul>
          <a class="btn btn-ghost" href={`${CONSOLE}/signup`}>Choose Dispute-Proof</a>
        </div>
      </div>
      <p class="price-more">Shipping more than 1,500 orders a month? <a href="#">WhatsApp us</a> — we'll sort a volume plan.</p>
      <p class="price-note">All plans: footage stays on your own Google Drive, timestamped at capture. International pricing coming soon.</p>
    </div>
  </section>

  <section class="faq" id="faq">
    <div class="wrap center">
      <span class="kicker">FAQ</span>
      <h2>Questions sellers actually ask</h2>
      <div class="faq-box">
        {FAQS.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="cta-band">
        <h2>Ready to pack with proof?</h2>
        <p>Your next order can be the first one with video evidence. Free for 50 orders a month — nothing to lose.</p>
        <a class="btn btn-white" href={`${CONSOLE}/signup`}>Start Free →</a>
      </div>
    </div>
  </section>

  <footer>
    <div class="wrap">
      <div class="foot-grid">
        <div class="foot-brand"><span class="dot"></span>Packory</div>
        <div class="foot-links">
          <a href="#why">Why Packory</a>
          <a href="#how">How it works</a>
          <a href="#pricing">Pricing</a>
          <a href="#faq">FAQ</a>
          <a href="/blog">Blog</a>
          <a href={`${CONSOLE}/login`}>Log in</a>
        </div>
      </div>
      <div class="foot-note">
        <span>© {new Date().getFullYear()} Packory · Every order. On video. Dispute-proof.</span>
        <span>Built in Malaysia — for sellers everywhere</span>
      </div>
    </div>
  </footer>

  <aside class="consent-banner" id="consent-banner" role="region" aria-label="Privacy consent" hidden>
    <p>We use basic analytics to improve the site, and we may contact you on WhatsApp about your Packory setup if you share your number. <a href="#">Privacy Policy</a></p>
    <div class="consent-actions">
      <button class="btn btn-blue btn-sm" type="button" data-consent="accept">Accept</button>
      <button class="btn btn-ghost-sm" type="button" data-consent="decline">Decline</button>
    </div>
  </aside>
</Base>

<script>
  const chipHTML = (c) => {
    const media = c[1]
      ? '<img src="' + c[1] + '" alt="' + c[0] + '" width="30" height="30"/>'
      : '<span class="lc-mono">' + (c[3] || c[0].slice(0, 2).toUpperCase()) + '</span>';
    return '<span class="logo-chip">' + media + '<span class="lc-name">' + c[0] + '</span><span class="tag-mini">' + c[2] + '</span></span>';
  };
  const fillRow = (id, list) => {
    const el = document.getElementById(id);
    if (el) el.innerHTML = list.map(chipHTML).join('') + list.map(chipHTML).join('');
  };
  // Row 1 — marketplaces (moves right)
  fillRow('row1', [
    ['Shopee', '/brands/shopee.svg', 'Marketplace'],
    ['TikTok Shop', '/brands/tiktok.svg', 'Marketplace'],
    ['Lazada', '/brands/lazada.svg', 'Marketplace'],
    ['Amazon', '/brands/amazon.svg', 'Marketplace'],
    ['eBay', '/brands/ebay.svg', 'Marketplace'],
    ['Walmart', '/brands/walmart.svg', 'Marketplace'],
    ['Etsy', '/brands/etsy.svg', 'Marketplace'],
  ]);
  // Row 2 — store builders + proof layer (moves left)
  fillRow('row2', [
    ['Shopify', '/brands/shopify.svg', 'Store'],
    ['WordPress + WooCommerce', '/brands/woocommerce.svg', 'Store'],
    ['BigCommerce', '/brands/bigcommerce.svg', 'Store'],
    ['Wix', '/brands/wix.svg', 'Store'],
    ['WhatsApp', '/brands/whatsapp.svg', 'Proof delivery'],
    ['Google Drive', '/brands/googledrive.svg', 'Storage'],
  ]);
  // Row 3 — couriers (moves right)
  fillRow('row3', [
    ['DHL', '/brands/dhl.svg', 'Courier'],
    ['FedEx', '/brands/fedex.svg', 'Courier'],
    ['UPS', '/brands/ups.svg', 'Courier'],
    ['USPS', '/brands/usps.svg', 'Courier'],
    ['J&T Express', null, 'Courier', 'JT'],
    ['Pos Laju', null, 'Courier', 'PL'],
  ]);

  const steps = document.querySelectorAll('.step-card');
  if (steps.length && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        if (en.isIntersecting) {
          en.target.style.transitionDelay = (en.target.dataset.i * 100) + 'ms';
          en.target.classList.add('in');
          io.unobserve(en.target);
        }
      }
    }, { threshold: 0.25 });
    steps.forEach((s) => io.observe(s));
  } else {
    steps.forEach((s) => s.classList.add('in'));
  }

  const pop = document.getElementById('pop-tier');
  if (pop && 'IntersectionObserver' in window) {
    const io2 = new IntersectionObserver((entries) => {
      for (const en of entries) {
        if (en.isIntersecting) { pop.classList.add('pulse'); io2.unobserve(pop); }
      }
    }, { threshold: 0.4 });
    io2.observe(pop);
  }

  const form = document.getElementById('lead-form');
  const errEl = document.getElementById('lead-err');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const raw = (form.querySelector('input').value || '').replace(/[\s-]/g, '');
      const digits = raw.replace(/\D/g, '');
      if (!/^(?:\+?6?0?1)\d{7,9}$/.test(digits)) {
        errEl.hidden = false;
        form.querySelector('input').focus();
        return;
      }
      errEl.hidden = true;
      let phone = digits;
      if (phone.indexOf('60') !== 0) phone = (phone.charAt(0) === '0' ? '60' + phone.slice(1) : '60' + phone);
      try {
        localStorage.setItem('packory_lead_phone', phone);
        localStorage.setItem('packory_lead_source', 'hero:wa');
      } catch (err) {}
      window.location.href = 'https://console.packory.app/signup?phone=' + encodeURIComponent(phone) + '&source=hero%3Awa';
    });
  }

  // Consent banner (PDPA / analytics). Show on first visit until a choice is made.
  const banner = document.getElementById('consent-banner');
  if (banner) {
    let consent = null;
    try { consent = localStorage.getItem('packory_consent'); } catch (err) {}
    if (!consent) {
      banner.hidden = false;
      banner.querySelectorAll('[data-consent]').forEach((btn) => {
        btn.addEventListener('click', () => {
          try { localStorage.setItem('packory_consent', btn.dataset.consent); } catch (err) {}
          banner.hidden = true;
        });
      });
    }
  }
</script>

<style is:global>
  :root{
    --color-ink:#10163a; --color-slate:#565f7a;
    --color-blue:#1856ed; --color-blue-deep:#0e3fc0; --color-blue-soft:#e9effd;
    --color-amber:#ff9e1a; --color-amber-deep:#b45f00; --color-amber-soft:#fff3da;
