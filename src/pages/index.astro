<script>
  const chipHTML = (c) => {
    const media = c[1]
      ? '<img src="' + c[1] + '" alt="' + c[0] + '" width="30" height="30"/>'
      : '<span class="lc-mono">' + (c[3] || c[0].slice(0, 2).toUpperCase()) + '</span>';
    return '<span class="logo-chip">' + media + '<span class="lc-name">' + c[0] + '</span><span class="tag-mini">' + c[2] + '</span></span>';
  };
  const fillRow = (id, list) => {
    const el = document.getElementById(id);
    if (el) el.innerHTML = list.map(chipHTML).join('') + list.map(chipHTML).join('');
  };
  // Row 1 — marketplaces (moves right)
  fillRow('row1', [
    ['Shopee', '/brands/shopee.svg', 'Marketplace'],
    ['TikTok Shop', '/brands/tiktok.svg', 'Marketplace'],
    ['Lazada', '/brands/lazada.svg', 'Marketplace'],
    ['Amazon', '/brands/amazon.svg', 'Marketplace'],
    ['eBay', '/brands/ebay.svg', 'Marketplace'],
    ['Walmart', '/brands/walmart.svg', 'Marketplace'],
    ['Etsy', '/brands/etsy.svg', 'Marketplace'],
  ]);
  // Row 2 — store builders + proof layer (moves left)
  fillRow('row2', [
    ['Shopify', '/brands/shopify.svg', 'Store'],
    ['WordPress + WooCommerce', '/brands/woocommerce.svg', 'Store'],
    ['BigCommerce', '/brands/bigcommerce.svg', 'Store'],
    ['Wix', '/brands/wix.svg', 'Store'],
    ['WhatsApp', '/brands/whatsapp.svg', 'Proof delivery'],
    ['Google Drive', '/brands/googledrive.svg', 'Storage'],
  ]);
  // Row 3 — couriers (moves right)
  fillRow('row3', [
    ['DHL', '/brands/dhl.svg', 'Courier'],
    ['FedEx', '/brands/fedex.svg', 'Courier'],
    ['UPS', '/brands/ups.svg', 'Courier'],
    ['USPS', '/brands/usps.svg', 'Courier'],
    ['J&T Express', null, 'Courier', 'JT'],
    ['Pos Laju', null, 'Courier', 'PL'],
  ]);

  // Scroll-triggered reveal: each step appears as IT enters the viewport (one-by-one on scroll).
  const steps = document.querySelectorAll('.step-card');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!steps.length) {
    // nothing to do
  } else if (reduceMotion) {
    steps.forEach((s) => s.classList.add('in'));
  } else if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        if (en.isIntersecting) {
          en.target.classList.add('in');
          io.unobserve(en.target);
        }
      }
    }, { threshold: 0, rootMargin: '0px 0px -6% 0px' });
    steps.forEach((s) => io.observe(s));
  } else {
    steps.forEach((s) => s.classList.add('in'));
  }

  const pop = document.getElementById('pop-tier');
  if (pop && 'IntersectionObserver' in window) {
    const io2 = new IntersectionObserver((entries) => {
      for (const en of entries) {
        if (en.isIntersecting) { pop.classList.add('pulse'); io2.unobserve(pop); }
      }
    }, { threshold: 0.4 });
    io2.observe(pop);
  }

  const form = document.getElementById('lead-form');
  const errEl = document.getElementById('lead-err');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const raw = (form.querySelector('input').value || '').replace(/[\s-]/g, '');
      const digits = raw.replace(/\D/g, '');
      if (!/^(?:\+?6?0?1)\d{7,9}$/.test(digits)) {
        errEl.hidden = false;
        form.querySelector('input').focus();
        return;
      }
      errEl.hidden = true;
      let phone = digits;
      if (phone.indexOf('60') !== 0) phone = (phone.charAt(0) === '0' ? '60' + phone.slice(1) : '60' + phone);
      try {
        localStorage.setItem('packory_lead_phone', phone);
        localStorage.setItem('packory_lead_source', 'hero:wa');
      } catch (err) {}
      window.location.href = 'https://console.packory.app/signup?phone=' + encodeURIComponent(phone) + '&source=hero%3Awa';
    });
  }

  // Mobile menu (hamburger drawer)
  const burger = document.getElementById('hamburger');
  const menu = document.getElementById('mobile-menu');
  const closeBtn = document.getElementById('m-close');
  if (burger && menu) {
    const setOpen = (open) => {
      menu.hidden = !open;
      burger.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    };
    burger.addEventListener('click', () => setOpen(menu.hidden));
    if (closeBtn) closeBtn.addEventListener('click', () => setOpen(false));
    menu.addEventListener('click', (e) => { if (e.target === menu) setOpen(false); });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) setOpen(false); });
  }

  // Consent banner (PDPA / analytics). Show on first visit until a choice is made.
  const banner = document.getElementById('consent-banner');
  if (banner) {
    let consent = null;
    try { consent = localStorage.getItem('packory_consent'); } catch (err) {}
    if (!consent) {
      banner.hidden = false;
      banner.querySelectorAll('[data-consent]').forEach((btn) => {
        btn.addEventListener('click', () => {
          try { localStorage.setItem('packory_consent', btn.dataset.consent); } catch (err) {}
          banner.hidden = true;
        });
      });
    }
  }

  // ===== How-it-works: horizontal scrollytelling — vertical scroll drives a sideways slide =====
  const howPin = document.getElementById('howPin');
  const howStage = document.getElementById('howStage');
  if (howPin && howStage && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const slides = Array.from(howStage.children);
    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
    // Each subsequent step starts one viewport to the LEFT; scrolling down moves the whole deck RIGHT.
    slides.forEach((s, i) => {
      s.style.transform = 'translate3d(-' + (i * 100) + '%,0,0)';
    });
    let active = 0;
    let desired = 0;
    let runner = false;
    const countEl = document.getElementById('howCount');
    const fillEl = document.getElementById('howFill');
    const setMeta = (i) => {
      if (countEl) countEl.textContent = String(i + 1).padStart(2, '0') + ' / ' + String(slides.length).padStart(2, '0');
      if (fillEl) fillEl.style.width = (((i + 1) / slides.length) * 100) + '%';
    };
    const applyIdx = () => {
      howStage.style.transform = 'translate3d(' + (active * 100) + '%,0,0)';
      setMeta(active);
    };
    const pump = () => {
      if (active < desired) active++;
      else if (active > desired) active--;
      applyIdx();
      if (active !== desired) {
        setTimeout(pump, 560); // one snap at a time — no 1→3→2→4 skipping
      } else {
        runner = false;
      }
    };
    setMeta(0);
    const update = () => {
      const total = Math.max(1, howPin.offsetHeight - window.innerHeight);
      const p = clamp(-howPin.getBoundingClientRect().top / total, 0, 1);
      desired = Math.min(slides.length - 1, Math.floor(p * slides.length + 0.001));
      if (desired !== active && !runner) {
        runner = true;
        pump();
      }
    };
    let ticking = false;
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(() => { update(); ticking = false; });
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    setInterval(onScroll, 200);
    update();
  }

  // Mobile: scroll-linked sideways entrance — content slides IN from the sides while you scroll up/down
  if (false) {
    const mSlides = Array.from(howStage.children);
    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
    const ease = (t) => 1 - Math.pow(1 - t, 3);
    const setEl = (el, x, op) => {
      if (!el) return;
      if (Math.abs(x) < 0.5 && op >= 1) { el.style.transform = ''; el.style.opacity = ''; }
      else { el.style.transform = 'translate3d(' + x.toFixed(1) + 'px,0,0)'; el.style.opacity = String(op); }
    };
    const mUpd = () => {
      const vh = window.innerHeight;
      for (const slide of mSlides) {
        const r = slide.getBoundingClientRect();
        if (r.bottom < 0 || r.top > vh) continue;
        const prog = clamp((vh * 0.92 - r.top) / (vh * 0.6), 0, 1);
        if (prog <= 0) continue;
        const e = ease(prog);
        const op = clamp(prog * 1.6, 0, 1);
        setEl(slide.querySelector('.step-num'), -24 * (1 - e), op);
        setEl(slide.querySelector('h3'), -38 * (1 - e), op);
        setEl(slide.querySelector('p'), -38 * (1 - e), op);
        setEl(slide.querySelector('.how-visual'), 42 * (1 - e), op);
        setEl(slide.querySelector('.how-ghost'), 0, op);
      }
    };
    window.addEventListener('scroll', mUpd, { passive: true });
    setInterval(mUpd, 150);
    mUpd();
  }
</script>

<style is:global>
