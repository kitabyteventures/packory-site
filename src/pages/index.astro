---
import Base from '../layouts/Base.astro';

const APP_NAME = 'Packory';
const CONSOLE = 'https://console.packory.app';

const STATS = [
  ['0', 'video bytes on our servers'],
  ['<100ms', 'UI reset after each order'],
  ['24/7', 'background sync & retry'],
  ['1.5s', 'throttled AWB scan rate'],
];

const CHANNELS = ['Shopee', 'TikTok Shop', 'Lazada', 'Shopify', 'eBay', 'Amazon', 'WhatsApp', 'Google Drive'];

const FIT = [
  { title: 'Shopee sellers', text: 'Win parcel-swap and empty-box disputes with timestamped packing video, delivered to the buyer on WhatsApp.' },
  { title: 'TikTok Shop sellers', text: 'Keep up with fast order flow without QC staff. The camera watches. The evidence files itself.' },
  { title: 'Multi-channel brands', text: 'One system across Shopee, TikTok, Lazada and more — one evidence link per order, every channel.' },
  { title: 'Packing operations', text: 'Run every station from one dashboard. Live status, sync health, dispute win-rate.' },
];

const PILLARS = [
  { n: '01', kicker: 'Proof', copy: 'Every order leaves with video evidence. No he-said-she-said.' },
  { n: '02', kicker: 'Speed', copy: 'Hands-free by design. Scan, record, thumbs-up — zero screen touches.' },
  { n: '03', kicker: 'Trust', copy: 'Buyers see their order being packed before it ships. Disputes lose their fuel.' },
  { n: '04', kicker: 'Scale', copy: 'One camera or fifty. More orders without more chaos or more disputes.' },
];

const WORKFLOW = [
  { label: 'AWB SCAN', copy: 'Barcode detected automatically at 1 frame per 1.5s.' },
  { label: 'RECORD', copy: 'Camera records hands-free. UTC timestamp burned into every frame.' },
  { label: 'THUMBS-UP', copy: 'Gesture stops the clip. Saved instantly to the device.' },
  { label: 'SYNC TO DRIVE', copy: 'Background upload to your own Google Drive. Resumes on reconnect.' },
  { label: 'WHATSAPP LINK', copy: 'Masked evidence link sent to the buyer automatically.' },
  { label: 'BUYER SEES PROOF', copy: 'Their order, packed correctly, on video — before it ships.' },
];

const FEATURES = [
  { title: 'Hands-free video proof', text: 'AWB detected automatically. Recording starts by itself and stops on a thumbs-up — packers never touch the screen.' },
  { title: 'Terrible Wi-Fi? No problem', text: 'Clips save to the device instantly and sync to the Admin’s private Google Drive in the background, resuming on reconnect.' },
  { title: 'Zero server video overhead', text: 'Your videos never pass through our servers. Bring-your-own Google Drive storage with a scope-limited token.' },
  { title: 'Dispute-proof orders', text: 'Beat parcel-swap and empty-box claims with timestamped, burned-in packing footage delivered to buyers on WhatsApp.' },
];

const FAQS = [
  { q: 'What is Packory?', a: 'Packory turns any cheap warehouse Android phone into a hands-free packing verification camera. Every order is recorded with a burned-in timestamp, stored in your own Google Drive, and the evidence link is sent straight to the buyer on WhatsApp.' },
  { q: 'Where are the videos stored?', a: 'On your own Google Drive. Videos never pass through our servers — bring-your-own storage with a scope-limited token. Zero server video overhead.' },
  { q: 'Does it need good Wi-Fi?', a: 'No. Clips save instantly on the device, then sync to Drive in the background, resuming automatically on reconnect. Works in hot, noisy warehouses with terrible Wi-Fi.' },
  { q: 'How does the packing stop?', a: 'Hands-free. The packer shows a thumbs-up and the clip stops automatically — no screen touching, no buttons, no workflow interruption.' },
  { q: 'What does it cost?', a: 'Pay per camera. Free tier includes 1 licensed camera. Starter RM49/mo, Pro RM99/mo, Scale RM199/mo. Paid securely via MYR FPX, cards, or local e-wallets.' },
  { q: 'Which platforms does it work with?', a: 'Any marketplace. Evidence links are delivered on WhatsApp, so it works with Shopee, TikTok Shop, Lazada, Shopify, eBay and more.' },
];

const PRICING = [
  { name: 'Free', price: 'RM 0', features: ['1 licensed camera', 'Manual WhatsApp links', 'Unlimited packing records'] },
  { name: 'Starter', price: 'RM 49/mo', features: ['2 licensed cameras', 'WhatsApp credits available', 'Weekly sheet automation'] },
  { name: 'Pro', price: 'RM 99/mo', features: ['5 licensed cameras', 'Direct seller channel', 'Priority support'] },
  { name: 'Scale', price: 'RM 199/mo', features: ['15 licensed cameras', 'All channels unlocked', 'Onboarding assistance'] },
];

const TESTIMONIALS = [
  { quote: 'We won every parcel-swap dispute last month — every single one had video proof.', who: 'Shopee seller · 400+ orders/week' },
  { quote: 'A buyer claimed the box arrived empty. We sent the packing video. Claim closed in a day.', who: 'TikTok Shop seller · Malaysia' },
];
---

<Base
  title="Packory — Every order. On video. Dispute-proof."
  description="Packory turns any cheap warehouse Android phone into a hands-free packing verification camera. Every order is recorded with a burned-in timestamp, stored in your own Google Drive, and the evidence link is sent straight to the buyer on WhatsApp."
>
  <!-- NAV -->
  <header class="am-nav">
    <div class="am-nav__inner">
      <a href="/" class="am-nav__brand">{APP_NAME}</a>
      <nav class="am-nav__links">
        <a href="#workflow" class="am-nav__link">Workflow</a>
        <a href="#features" class="am-nav__link">Features</a>
        <a href="#pricing" class="am-nav__link">Pricing</a>
        <a href="#faq" class="am-nav__link">FAQ</a>
        <a href={`${CONSOLE}/login`} class="am-nav__link am-nav__mlink">Log In</a>
        <a href={`${CONSOLE}/signup`} class="am-btn am-btn--primary am-nav__cta">Start Free</a>
      </nav>
    </div>
  </header>

  <!-- HERO -->
  <section class="fo-hero">
    <div class="am-wrap">
      <p class="am-eyebrow am-eyebrow--ondark">Packing verification for ecommerce</p>
      <h1 class="fo-hero__title">EVERY ORDER.<br />ON VIDEO.<br />DISPUTE-PROOF.</h1>
      <p class="fo-hero__lead">
        Packory turns any cheap warehouse Android phone into a hands-free packing
        verification camera. Every order is recorded with a burned-in timestamp, stored in
        your own Google Drive, and the evidence link is sent straight to the buyer on WhatsApp.
      </p>
      <div class="fo-hero__actions">
        <a href={`${CONSOLE}/signup`} class="am-btn am-btn--navy">Start Free</a>
        <a href="#workflow" class="am-btn am-btn--outline am-btn--navyline">See how it works</a>
      </div>
      <div class="fo-hero__visual">
        <div class="fo-code">
          <div class="fo-code__bar">
            <span></span><span></span><span></span>
            <em>packing-terminal · station a</em>
            <b class="fo-code__live"><i></i>LIVE</b>
          </div>
          <div class="fo-code__body">
            <div class="fo-code__row"><span>AWB</span><strong>123456789012 <b class="ok">✓</b></strong></div>
            <div class="fo-code__row"><span>STATUS</span><strong><b class="rec"></b> RECORDING — UTC 12:04:31</strong></div>
            <div class="fo-code__row"><span>SYNC</span><strong>SYNCED TO DRIVE <b class="ok">✓</b></strong></div>
            <div class="fo-code__row"><span>WHATSAPP</span><strong>EVIDENCE LINK SENT <b class="ok">✓</b></strong></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROOFBAR -->
  <section class="fo-proofbar">
    <div class="am-wrap fo-proofbar__inner">
      {STATS.map(([k, v]) => (
        <div><strong>{k}</strong><span>{v}</span></div>
      ))}
    </div>
  </section>

  <!-- INTRO / CHANNELS -->
  <section class="fo-intro">
    <div class="am-wrap fo-intro__grid">
      <div>
        <p class="am-eyebrow">Integrations</p>
        <h2 class="am-section__title">Prove every order,<br />on every channel.</h2>
      </div>
      <div>
        <p class="fo-intro__text">One evidence link, sent to the buyer on WhatsApp — regardless of marketplace. Connect your stores, pack once, and every order leaves with video proof.</p>
        <div class="fo-intro__tags">
          {CHANNELS.map((c) => (<span class="fo-intro__tag">{c}</span>))}
        </div>
      </div>
    </div>
  </section>

  <!-- FIT -->
  <section class="fo-fit">
    <div class="am-wrap fo-fit__grid">
      <div>
        <p class="am-eyebrow">Who it’s for</p>
        <h2 class="am-section__title">Built for sellers who can’t afford another empty-box claim.</h2>
      </div>
      <div class="fo-fit__cards">
        {FIT.map((f, i) => (
          <article class="fo-fit-card">
            <span class={`fo-fit-card__accent fo-fit-card__accent--left`}></span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY / PILLARS -->
  <section class="fo-why">
    <div class="am-wrap fo-why__grid">
      <div>
        <p class="am-eyebrow">Why Packory</p>
        <h2 class="am-section__title">Four pillars.<br />One outcome: trust.</h2>
      </div>
      <div class="fo-why__points">
        {PILLARS.map((p) => (
          <div class="fo-why__point">
            <b>{p.n}</b>
            <div><strong>{p.kicker}</strong><span>{p.copy}</span></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CODE / WORKFLOW -->
  <section id="workflow" class="fo-workflow">
    <div class="am-wrap">
      <p class="am-eyebrow am-eyebrow--ondark">How it works</p>
      <h2 class="am-section__title am-section__title--ondark">From AWB scan to evidence sent.<br />Automatically.</h2>
      <div class="fo-workflow__grid">
        {WORKFLOW.map((w, i) => (
          <div class="fo-workflow__step">
            <span class="fo-workflow__num">{String(i + 1).padStart(2, '0')}</span>
            <strong>{w.label}</strong>
            <p>{w.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DOCS / FEATURES -->
  <section id="features" class="fo-docs">
    <div class="am-wrap">
      <div class="fo-docs__head">
        <p class="am-eyebrow">Features</p>
        <h2 class="am-section__title">Engineered for hot, noisy warehouses.</h2>
      </div>
      <div class="fo-docs__cards">
        {FEATURES.map((f, i) => (
          <a class="fo-docs__card">
            <span class="fo-docs__number">{String(i + 1).padStart(2, '0')}</span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section id="pricing" class="fo-pricing">
    <div class="am-wrap">
      <p class="am-eyebrow">Pricing</p>
      <h2 class="am-section__title">Pay per camera.</h2>
      <p class="fo-pricing__sub">One license per device. Paid securely via MYR FPX, cards, or local e-wallets.</p>
      <div class="fo-pricing__grid">
        {PRICING.map((p) => (
          <div class="fo-pricing__card">
            <div class="fo-pricing__name">{p.name}</div>
            <div class="fo-pricing__price">{p.price}</div>
            <ul>
              {p.features.map((f) => (<li><b>✓</b>{f}</li>))}
            </ul>
            <a href={`${CONSOLE}/signup`} class="am-btn am-btn--primary am-btn--lime fo-pricing__btn">Get started</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="fo-testi">
    <div class="am-wrap fo-testi__grid">
      {TESTIMONIALS.map((t) => (
        <blockquote class="fo-testi__card">
          <p>“{t.quote}”</p>
          <footer>{t.who}</footer>
        </blockquote>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="fo-faq">
    <div class="am-wrap fo-faq__grid">
      <div>
        <p class="am-eyebrow">FAQ</p>
        <h2 class="am-section__title">The things every seller asks.</h2>
      </div>
      <div class="am-faq">
        {FAQS.map((f) => (
          <details class="am-faq__item">
            <summary class="am-faq__q">{f.q}<span class="am-faq__plus"></span></summary>
            <div class="am-faq__a">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="fo-cta">
    <div class="am-wrap fo-cta__inner">
      <p class="am-eyebrow am-eyebrow--ondark">Get started</p>
      <h2 class="am-section__title am-section__title--ondark">Ready to put your orders<br />on the record?</h2>
      <p class="fo-cta__lead">Turn any Android phone into a hands-free packing verification camera. Free to start. Your videos stay in your own Google Drive.</p>
      <div class="fo-cta__actions">
        <a href={`${CONSOLE}/signup`} class="am-btn am-btn--primary am-btn--lime">Start Free</a>
        <a href={`${CONSOLE}/login`} class="am-btn am-btn--outline am-btn--ondark">Book a demo</a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="am-footer">
    <div class="am-wrap am-footer__inner">
      <div>
        <div class="am-footer__tag">{APP_NAME}</div>
        <p class="am-footer__location">Built for Malaysian e-commerce merchants 🇲🇾</p>
      </div>
      <div class="am-footer__cols">
        <div class="am-footer__col">
          <a href="#workflow">Workflow</a>
          <a href="#features">Features</a>
          <a href="#pricing">Pricing</a>
        </div>
        <div class="am-footer__col">
          <a href={`${CONSOLE}/login`}>Log In</a>
          <a href={`${CONSOLE}/signup`}>Sign Up</a>
          <a href="#faq">FAQ</a>
        </div>
      </div>
    </div>
    <div class="am-wrap am-footer__base">
      <span>© {new Date().getFullYear()} {APP_NAME}</span>
      <span class="am-footer__base-links">Every order. On video. Dispute-proof.</span>
    </div>
  </footer>
</Base>

<style>
  /* ===== FOUNDRY-STYLE SYSTEM — Packory colors: navy #0f0e54 + lime #d9f20c + white + black ===== */
  :root {
    --navy: #0f0e54;
    --navy-deep: #0a092e;
    --neon: #39ff14;
    --neon-soft: #7dff66;
    --ink: #111111;
    --ink-soft: #222222;
    --slate: #6b6b75;
    --slate-200: #e5e5ea;
    --paper: #fafaf8;
    --off-white: #f4f4f1;
    --white: #ffffff;
    --dur: 0.3s;
    --dur-fast: 0.15s;
    --font-display: 'Montserrat', system-ui, sans-serif;
    --font-body: 'Montserrat', system-ui, sans-serif;
    --font-mono: ui-monospace, 'SF Mono', Menlo, monospace;
  }

  * { box-sizing: border-box; margin: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: var(--font-body); color: var(--ink); background: var(--white); -webkit-font-smoothing: antialiased; overflow-wrap: anywhere; }

  .am-wrap { width: min(1180px, 100% - 64px); margin: 0 auto; }
  a { color: inherit; text-decoration: none; }

  /* ===== BUTTONS (foundry am-btn) ===== */
  .am-btn { cursor: pointer; min-height: 48px; transition: transform var(--dur-fast), background var(--dur), border-color var(--dur); border: 1px solid transparent; border-radius: 0; justify-content: center; align-items: center; gap: 9px; padding: 0 24px; font-weight: 700; font-size: 14px; display: inline-flex; }
  .am-btn:hover { transform: translateY(-2px); }
  .am-btn--primary { background: var(--neon); color: var(--navy); }
  .am-btn--lime { background: var(--neon); color: var(--navy); }
  .am-btn--navy { background: var(--navy); color: var(--white); }
  .am-btn--outline { background: transparent; border-color: #d0d0d6; color: var(--ink); }
  .am-btn--navyline { border-color: rgba(15,14,84,0.45); color: var(--navy); }
  .am-btn--ondark { border-color: rgba(255,255,255,0.35); color: var(--white); }
  .am-btn--ghostdark { background: transparent; color: var(--white); }

  /* ===== EYEBROW (foundry am-eyebrow) ===== */
  .am-eyebrow { color: var(--neon); font-family: var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; align-items: center; gap: 10px; margin-bottom: 22px; font-size: 15px; font-weight: 600; display: flex; }
  .am-eyebrow--ondark { color: var(--neon); }
  .am-eyebrow:before { content: ""; width: 18px; height: 2px; background: var(--neon); display: block; }

  /* ===== SECTION TITLE (foundry am-section__title) ===== */
  .am-section__title { max-width: 720px; font-family: var(--font-display); letter-spacing: -0.055em; margin: 0; font-size: clamp(38px, 5.1vw, 68px); font-weight: 700; line-height: 0.98; }
  .am-section__title--ondark { color: var(--white); }

  /* ===== NAV (foundry am-nav) ===== */
  .am-nav { position: sticky; top: 0; z-index: 100; background: rgba(15,14,84,0.92); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(255,255,255,0.08); }
  .am-nav__inner { display: flex; align-items: center; justify-content: space-between; height: 72px; }
  .am-nav__brand { font-family: var(--font-display); font-weight: 700; font-size: 20px; color: var(--white); letter-spacing: -0.02em; }
  .am-nav__links { display: flex; align-items: center; gap: 26px; }
  .am-nav__link { color: rgba(255,255,255,0.78); font-size: 14px; font-weight: 500; transition: color var(--dur-fast); }
  .am-nav__link:hover { color: var(--white); }
  .am-nav__mlink { }
  .am-nav__cta { min-height: 40px; padding: 0 18px; font-size: 13px; }

  /* ===== HERO (foundry fo-hero) — NEON PRIMARY ===== */
  .fo-hero { background: var(--neon); color: var(--navy); min-height: 780px; padding: 140px 0 100px; position: relative; overflow: hidden; }
  .fo-hero:before { content: ""; border: 150px solid rgba(15,14,84,0.06); width: 720px; height: 720px; position: absolute; inset: auto -6% -40% 48%; transform: rotate(20deg); }
  .fo-hero__title { font-family: var(--font-display); letter-spacing: -0.05em; font-size: clamp(48px, 7.2vw, 96px); font-weight: 700; line-height: 0.95; color: var(--navy); }
  .fo-hero__lead { max-width: 620px; margin-top: 28px; font-size: 17px; line-height: 1.7; color: rgba(15,14,84,0.78); font-weight: 500; }
  .fo-hero__actions { display: flex; gap: 14px; margin-top: 36px; flex-wrap: wrap; }
  .fo-hero__visual { margin-top: 60px; max-width: 620px; }
  .fo-hero .am-eyebrow { color: var(--navy); }
  .fo-hero .am-eyebrow:before { background: var(--navy); }
  .fo-hero .am-btn--outline { border-color: rgba(15,14,84,0.4); color: var(--navy); }

  /* code window (foundry fo-code) */
  .fo-code { border: 1px solid rgba(255,255,255,0.14); background: var(--navy-deep); border-radius: 10px; overflow: hidden; }
  .fo-code__bar { border-bottom: 1px solid rgba(255,255,255,0.1); align-items: center; gap: 7px; padding: 14px 16px; display: flex; }
  .fo-code__bar > span { background: #4b5159; border-radius: 50%; width: 8px; height: 8px; }
  .fo-code__bar em { margin-left: 8px; font-style: normal; font-family: var(--font-mono); font-size: 12px; color: rgba(255,255,255,0.5); flex: 1; }
  .fo-code__live { display: inline-flex; align-items: center; gap: 7px; font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.1em; color: var(--neon); font-style: normal; }
  .fo-code__live i { width: 7px; height: 7px; border-radius: 50%; background: var(--neon); animation: pulse 1.6s ease-in-out infinite; }
  @keyframes pulse { 0%,100% { opacity:1; box-shadow:0 0 0 0 rgba(57,255,20,0.5);} 50% { opacity:.55; box-shadow:0 0 0 6px rgba(57,255,20,0);} }
  .fo-code__body { padding: 20px 24px; display: flex; flex-direction: column; gap: 14px; }
  .fo-code__row { display: flex; gap: 20px; align-items: baseline; font-family: var(--font-mono); font-size: 13px; }
  .fo-code__row span { width: 84px; color: rgba(255,255,255,0.4); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; }
  .fo-code__row strong { color: rgba(255,255,255,0.92); font-weight: 500; }
  .ok { color: var(--neon); font-weight: 700; }
  .rec { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--neon); animation: pulse 1.6s infinite; }

  /* ===== PROOFBAR (foundry fo-proofbar) ===== */
  .fo-proofbar { border-bottom: 1px solid var(--slate-200); background: var(--white); }
  .fo-proofbar__inner { grid-template-columns: repeat(4, 1fr); display: grid; }
  .fo-proofbar__inner div { border-right: 1px solid var(--slate-200); padding: 28px 24px; }
  .fo-proofbar__inner div:last-child { border-right: none; }
  .fo-proofbar__inner strong { display: block; font-family: var(--font-display); font-size: 30px; font-weight: 700; letter-spacing: -0.03em; color: var(--navy); }
  .fo-proofbar__inner span { display: block; margin-top: 6px; font-size: 13px; color: var(--slate); line-height: 1.4; }

  /* ===== INTRO (foundry fo-intro) ===== */
  .fo-intro { background: var(--paper); padding: 120px 0; }
  .fo-intro__grid { grid-template-columns: 1.05fr 0.75fr; align-items: start; gap: clamp(48px, 9vw, 120px); display: grid; }
  .fo-intro__text { font-size: 16px; line-height: 1.7; color: var(--slate); margin-top: 8px; }
  .fo-intro__tags { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .fo-intro__tag { border: 1px solid var(--slate-200); background: var(--white); border-radius: 0; padding: 10px 16px; font-size: 13px; font-weight: 600; color: var(--ink); }

  /* ===== FIT (foundry fo-fit) ===== */
  .fo-fit { background: var(--off-white); padding: 120px 0; }
  .fo-fit__grid { grid-template-columns: 0.65fr 1.35fr; gap: 70px; display: grid; }
  .fo-fit__cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .fo-fit-card { background: var(--white); border: 1px solid var(--slate-200); padding: 34px; position: relative; overflow: hidden; transition: transform var(--dur); }
  .fo-fit-card:hover { transform: translateY(-3px); }
  .fo-fit-card__accent { position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--neon); transform: scaleY(0); transform-origin: top; transition: transform var(--dur); }
  .fo-fit-card:hover .fo-fit-card__accent { transform: scaleY(1); }
  .fo-fit-card h3 { font-family: var(--font-display); font-size: 20px; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 12px; }
  .fo-fit-card p { font-size: 14px; line-height: 1.65; color: var(--slate); }

  /* ===== WHY (foundry fo-why) ===== */
  .fo-why { border-block: 1px solid var(--slate-200); background: var(--white); padding: 120px 0; }
  .fo-why__grid { grid-template-columns: 0.8fr 1.15fr; gap: clamp(54px, 9vw, 120px); display: grid; }
  .fo-why__points { display: flex; flex-direction: column; }
