---
import Base from '../layouts/Base.astro';

const APP_NAME = 'Packory';
const CONSOLE = 'https://console.packory.app';

const CHANNELS = ['Shopee', 'TikTok Shop', 'Lazada', 'Shopify', 'eBay', 'Amazon', 'WhatsApp', 'Google Drive'];

const PILLARS = [
  { n: '01', kicker: 'PROOF', copy: 'Every order leaves with video evidence. No he-said-she-said.' },
  { n: '02', kicker: 'SPEED', copy: 'Hands-free by design. Scan, record, thumbs-up — zero screen touches.' },
  { n: '03', kicker: 'TRUST', copy: 'Buyers see their order being packed before it ships. Disputes lose their fuel.' },
  { n: '04', kicker: 'SCALE', copy: 'One camera or fifty. More orders without more chaos or more disputes.' },
];

const WORKFLOW = [
  { label: 'AWB SCAN', copy: 'Barcode detected automatically.' },
  { label: 'RECORD', copy: 'UTC burned into every frame.' },
  { label: 'THUMBS-UP', copy: 'Gesture stops the clip.' },
  { label: 'SYNC', copy: 'Background upload to Drive.' },
  { label: 'WHATSAPP', copy: 'Evidence link sent to buyer.' },
];

const STATIONS = [
  { name: 'STATION A', detail: 'PACKING LINE 1', orders: '1,248', rate: '100% COVERAGE', status: 'LIVE' },
  { name: 'STATION B', detail: 'SMALL PARCELS', orders: '864', rate: '99.2% SYNC', status: 'READY' },
  { name: 'STATION C', detail: 'BULK / COD', orders: 'PAIRING…', rate: 'ACTION NEEDED', status: 'PAIR' },
];

const METRICS = [
  { label: 'Orders today', value: '1,842' },
  { label: 'Videos captured', value: '1,840' },
  { label: 'Evidence delivered', value: '1,832' },
  { label: 'Dispute win-rate', value: '98.4%' },
  { label: 'Sync failures', value: '3' },
  { label: 'On-time WhatsApp', value: '99.1%' },
];

const FEATURES = [
  { title: 'HANDS-FREE VIDEO PROOF', text: 'AWB detected automatically. Recording starts by itself and stops on a thumbs-up — packers never touch the screen.' },
  { title: 'TERRIBLE WI-FI? NO PROBLEM', text: 'Clips save to the device instantly and sync to the Admin’s private Google Drive in the background, resuming on reconnect.' },
  { title: 'ZERO SERVER VIDEO OVERHEAD', text: 'Your videos never pass through our servers. Bring-your-own Google Drive storage with a scope-limited token.' },
  { title: 'DISPUTE-PROOF ORDERS', text: 'Beat parcel-swap and empty-box claims with timestamped, burned-in packing footage delivered to buyers on WhatsApp.' },
];

const PRICING = [
  { name: 'FREE', price: 'RM 0', features: ['1 licensed camera', 'Manual WhatsApp links', 'Unlimited packing records'] },
  { name: 'STARTER', price: 'RM 49/MO', features: ['2 licensed cameras', 'WhatsApp credits available', 'Weekly sheet automation'] },
  { name: 'PRO', price: 'RM 99/MO', features: ['5 licensed cameras', 'Direct seller channel', 'Priority support'] },
  { name: 'SCALE', price: 'RM 199/MO', features: ['15 licensed cameras', 'All channels unlocked', 'Onboarding assistance'] },
];

const TESTIMONIALS = [
  { quote: 'We won every parcel-swap dispute last month — every single one had video proof.', who: 'SHOPEE SELLER · 400+ ORDERS/WEEK' },
  { quote: 'A buyer claimed the box arrived empty. We sent the packing video. Claim closed in a day.', who: 'TIKTOK SHOP SELLER · MALAYSIA' },
];
---

<Base
  title="Packory — Every order. On video. Dispute-proof."
  description="Packory turns any cheap warehouse Android phone into a hands-free packing verification camera. Every order is recorded with a burned-in timestamp, stored in your own Google Drive, and the evidence link is sent straight to the buyer on WhatsApp."
>
  <main class="collage">
    <!-- SLIDE 1 — HERO: teal stage + big photo-circle -->
    <section class="slide one">
      <aside class="meta-rail"><div class="n">01</div><div class="year">2026<br />Selected</div><div class="menu-mark"></div></aside>
      <div class="stage">
        <div class="content">
          <div class="wordmark">PACKORY</div>
          <p class="kicker" style="margin-top:36px">Packing verification for ecommerce</p>
          <h1 class="slide-title">EVERY ORDER.<br />ON VIDEO.<br /><span class="t-orange">DISPUTE-PROOF.</span></h1>
          <p class="copy" style="margin-top:18px">Hands-free packing verification. Timestamped video evidence, synced to your own Google Drive, delivered to the buyer on WhatsApp.</p>
          <div class="hero-actions" style="margin-top:26px">
            <a href={`${CONSOLE}/signup`} class="btn-solid">Start Free</a>
            <a href="#slide4" class="btn-ghost">How It Works</a>
          </div>
        </div>
        <div class="photo-circle">
          <div class="term">
            <div class="term-bar"><span class="term-title">TERMINAL · A</span><span class="live"><span class="pulse"></span>LIVE</span></div>
            <div class="term-body">
              <div class="term-row"><span class="tl">AWB</span><span class="tv">123456789012 <span class="ok">✓</span></span></div>
              <div class="term-row"><span class="tl">STATUS</span><span class="tv"><span class="rec"></span> RECORDING</span></div>
              <div class="term-row"><span class="tl">SYNC</span><span class="tv">SYNCED <span class="ok">✓</span></span></div>
              <div class="term-row"><span class="tl">WA</span><span class="tv">LINK SENT <span class="ok">✓</span></span></div>
            </div>
            <div class="term-bc"><span class="bc-bars"></span><span class="bc-text">PKR-0A3F-9C2E-7741</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- SLIDE 2 — CHANNELS: orange pane + thumb row -->
    <section id="slide2" class="slide two">
      <aside class="meta-rail" style="background:var(--orange)"><div class="n">02</div><div class="year">2026<br />Work</div><div class="menu-mark"></div></aside>
      <div class="orange-pane">
        <div class="wordmark">CONNECTED.</div>
        <div class="chan-list">
          {CHANNELS.map((c) => (
            <div class="chan-line"><span class="dot-sm"></span><span>{c}</span><span class="chk">✓</span></div>
          ))}
        </div>
      </div>
      <div class="content">
        <div class="thumb-row">
          <div class="thumb t1"><span>SHOPEE</span></div>
          <div class="thumb t2"><span>TIKTOK</span></div>
          <div class="thumb t3"><span>LAZADA</span></div>
        </div>
        <div class="wordmark">EVERY CHANNEL</div>
        <div class="grid-2" style="gap:18px;margin-top:30px">
          <div><p class="kicker">One link</p><p class="copy">Evidence link sent to the buyer on WhatsApp — regardless of marketplace.</p></div>
          <div><p class="kicker">Zero servers</p><p class="copy">Your videos never pass through our servers. Bring-your-own Google Drive.</p></div>
        </div>
      </div>
    </section>

    <!-- SLIDE 3 — PROBLEM: gallery + captions + teal block -->
    <section id="slide3" class="slide three">
      <aside class="meta-rail"><div class="n">03</div><div class="year">2026<br />Problem</div><div class="menu-mark"></div></aside>
      <div class="content" style="display:grid;grid-template-columns:190px 1fr;gap:28px;align-items:start">
        <div class="gallery">
          <div class="gal-big"><span class="x">×</span><p>DISPUTE</p></div>
          <div class="gal-sm"><span class="x">×</span><p>EMPTY BOX</p></div>
          <div class="gal-sm"><span class="x">×</span><p>REFUND FORCED</p></div>
        </div>
        <div>
          <div class="wordmark">THE PROBLEM</div>
          <p class="kicker" style="margin-top:34px">Parcel-swap &amp; empty-box</p>
          <p class="copy">Marketplace dispute. Buyer claim: “empty box”. Refund forced. No proof of packing. Manual WhatsApp threads.</p>
          <p class="kicker" style="margin-top:30px">With Packory</p>
          <p class="copy strong-copy">Automated, timestamped, tamper-evident video. Evidence on WhatsApp. Dispute fuel removed.</p>
        </div>
      </div>
      <div style="background:var(--teal);display:flex;align-items:center;justify-content:center;padding:20px"><div class="big-arrow">→</div></div>
    </section>

    <!-- SLIDE 4 — PILLARS: wordmark + hatch + hero block -->
    <section id="slide4" class="slide four">
      <aside class="meta-rail"><div class="n">04</div><div class="year">2026<br />System</div><div class="menu-mark"></div></aside>
      <div class="content">
        <div class="wordmark teal-dot">WHY PACKORY</div>
        <h2 class="slide-title" style="margin-top:36px">FOUR PILLARS.<br />ONE OUTCOME:<br />TRUST.</h2>
        <div class="hatch" style="margin-top:26px"></div>
      </div>
      <div class="hero-car">
        <div class="pillar-list">
          {PILLARS.map((p) => (
            <div class="pillar-line"><b>{p.n}</b><span class="kicker">{p.kicker}</span><span class="copy">{p.copy}</span></div>
          ))}
        </div>
      </div>
    </section>

    <!-- SLIDE 5 — WORKFLOW: strips -->
    <section id="slide5" class="slide five">
      <aside class="meta-rail"><div class="n">05</div><div class="year">2026<br />Flow</div><div class="menu-mark"></div></aside>
      <div class="strips">
        {WORKFLOW.slice(0, 3).map((w, i) => (
          <div class={`strip strip-${i}`}><div class="strip-num">{['A','B','C'][i]}</div><div class="strip-label">{w.label}</div><div class="strip-copy">{w.copy}</div></div>
        ))}
        <div class="wordmark" style="position:absolute;left:38%;top:30px">FROM AWB TO EVIDENCE</div>
      </div>
    </section>

    <!-- SLIDE 6 — WORKFLOW CONT: device + content -->
    <section class="slide six">
      <aside class="meta-rail teal-side"><div class="n">06</div><div class="year">2026<br />Flow</div><div class="menu-mark"></div></aside>
      <div><div class="device"><div class="dev-screen"><div class="dev-row"><span>AWB</span><b>✓ 1234…</b></div><div class="dev-row"><span>REC</span><b class="dev-rec">● RECORDING</b></div><div class="dev-row"><span>SYNC</span><b>✓ DRIVE</b></div><div class="dev-row"><span>WA</span><b>✓ SENT</b></div></div></div></div>
      <div class="content">
        <div class="wordmark teal-dot">HANDS-FREE</div>
        <p class="kicker" style="margin-top:38px">Thumbs-up</p>
        <p class="copy">Gesture stops the clip automatically. Saved instantly, synced in the background.</p>
        <p class="kicker" style="margin-top:24px">Thumbs-up</p>
        <p class="copy">Resumes on reconnect. 24/7 background sync &amp; retry.</p>
      </div>
    </section>

    <!-- SLIDE 7 — STATIONS: mosaic -->
    <section id="slide7" class="slide seven">
      <aside class="meta-rail" style="background:var(--teal);color:white"><div class="n">07</div><div class="year">2026<br />Ops</div><div class="menu-mark"></div></aside>
      <div class="mosaic">
        {STATIONS.map((s, i) => (
          <div class={`mos mos-${i}`}>
            <div class="mos-head"><span>{s.name}</span>{s.status === 'LIVE' && <span class="sc-live"><span class="pulse"></span>LIVE</span>}{s.status === 'READY' && <span class="sc-ready">READY</span>}{s.status === 'PAIR' && <span class="sc-pair">PAIR</span>}</div>
            <div class="mos-detail">{s.detail}</div>
            <div class="mos-orders">{s.orders} <span class="mos-unit">verified</span></div>
            <div class="mos-rate">{s.rate}</div>
          </div>
        ))}
        <div class="wordmark" style="position:absolute;left:24%;top:26px">RUN EVERY STATION</div>
      </div>
    </section>

    <!-- SLIDE 8 — ANALYTICS: visual grid + teal content -->
    <section id="slide8" class="slide eight">
      <aside class="meta-rail"><div class="n">08</div><div class="year">2026<br />Data</div><div class="menu-mark"></div></aside>
      <div class="visual-grid">
        {METRICS.map((m) => (
          <div class="vg-cell"><b>{m.value}</b><span class="kicker">{m.label}</span></div>
        ))}
      </div>
      <div class="content" style="background:var(--teal)">
        <div class="wordmark">ANALYTICS</div>
        <p class="kicker" style="margin-top:34px">Before it becomes a claim</p>
        <p class="copy">Orders today. Videos captured. Evidence delivered. Dispute win-rate.</p>
        <div class="kpi-strip" style="margin-top:26px">
          <div class="kpi-mini"><b>100%</b><span>ORDERS ON VIDEO</span></div>
          <div class="kpi-mini"><b>0</b><span>SERVER BYTES</span></div>
        </div>
      </div>
    </section>

    <!-- SLIDE 9 — FEATURES: monitor + gradient -->
    <section id="slide9" class="slide nine">
      <aside class="meta-rail" style="background:var(--teal);color:white"><div class="n">09</div><div class="year">2026<br />Build</div><div class="menu-mark"></div></aside>
      <div>
        <div class="wordmark" style="margin:28px 0 0 38px">FEATURES</div>
        <div class="monitor">
          <div class="mon-feature"><span class="mf-key">AWB</span><span>Detected automatically, hands-free</span></div>
          <div class="mon-feature"><span class="mf-key">REC</span><span>UTC timestamp burned in</span></div>
          <div class="mon-feature"><span class="mf-key">WA</span><span>Evidence link sent to buyer</span></div>
          <div class="mon-feature"><span class="mf-key">0</span><span>Video bytes on our servers</span></div>
        </div>
      </div>
      <div class="grad-side">
        <div class="feature-card"><div class="kicker">TERRIBLE WI-FI?</div><p class="copy">Clips save instantly, sync in the background, resume on reconnect.</p></div>
        <div class="feature-card"><div class="kicker">DISPUTE-PROOF</div><p class="copy">Beat parcel-swap and empty-box claims with burned-in footage.</p></div>
      </div>
    </section>

    <!-- SLIDE 10 — PRICING + CTA: device + content -->
    <section id="slide10" class="slide ten">
      <aside class="meta-rail" style="background:var(--orange);color:white"><div class="n">10</div><div class="year">2026<br />Plan</div><div class="menu-mark"></div></aside>
      <div><div class="device"><div class="dev-screen"><div class="dev-row"><span>PLAN</span><b>PRO</b></div><div class="dev-row"><span>PRICE</span><b>RM 99</b></div><div class="dev-row"><span>CAMS</span><b>5</b></div><div class="dev-row"><span>WA</span><b>✓ UNLOCKED</b></div></div></div></div>
      <div class="content">
        <div class="wordmark teal-dot">PAY PER CAMERA</div>
        <p class="kicker" style="margin-top:34px">Free · Starter · Pro · Scale</p>
        <p class="copy">One license per device. Paid securely via MYR FPX, cards, or local e-wallets.</p>
        <div class="pricing-mini" style="margin-top:24px">
          {PRICING.map((p) => (<div class="pm"><span class="pm-name">{p.name}</span><span class="pm-price">{p.price}</span></div>))}
        </div>
        <div class="hero-actions" style="margin-top:30px">
          <a href={`${CONSOLE}/signup`} class="btn-solid">Start Free</a>
          <a href={`${CONSOLE}/login`} class="btn-ghost">Book a Demo</a>
        </div>
      </div>
    </section>
  </main>

  <!-- TESTIMONIALS + FINAL CTA -->
  <section id="contact" class="contact">
    <aside class="meta-rail"><div class="n">11</div><div class="year">2026<br />Proof</div><div class="menu-mark"></div></aside>
    <div class="section-body">
      <div class="wordmark">CUSTOMERS</div>
      <div class="testi-grid" style="margin-top:26px">
        {TESTIMONIALS.map((t) => (
          <div class="testi"><p class="t-quote">“{t.quote}”</p><span class="kicker">{t.who}</span></div>
        ))}
      </div>
      <h2 class="title big" style="margin-top:46px">READY TO PUT YOUR ORDERS<br />ON THE RECORD?</h2>
      <div class="hero-actions" style="margin-top:30px">
        <a href={`${CONSOLE}/signup`} class="btn-solid">Start Free</a>
        <a href={`${CONSOLE}/login`} class="btn-ghost">Book a Demo</a>
      </div>
    </div>
  </section>

  <footer class="footer">
    <span>© {new Date().getFullYear()} PACKORY</span>
    <span>BUILT FOR MALAYSIAN E-COMMERCE MERCHANTS 🇲🇾</span>
  </footer>
</Base>

<style>
  :root {
    --orange: #fd8405; --teal: #13b9b6; --white: #fefefd; --charcoal: #341c19;
    --burnt: #e45507; --tangerine: #f89437; --mist: #bfd1ce; --peach: #f2b279;
    --shadow: 0 16px 22px rgba(117,35,0,.34);
  }
  * { box-sizing: border-box; }

  .kicker { font-size: 10px; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; }
  .copy { font-size: 11px; line-height: 1.65; max-width: 36ch; }
  .strong-copy { font-weight: 700; }
  .slide-title { margin: 0; font-size: clamp(28px, 4vw, 56px); line-height: .92; font-weight: 900; letter-spacing: -.04em; text-transform: uppercase; }
  .wordmark { position: relative; z-index: 1; display: inline-block; font-size: clamp(22px, 3vw, 40px); font-weight: 900; letter-spacing: -.04em; text-transform: uppercase; }
  .wordmark::before { content: ""; position: absolute; z-index: -1; width: .92em; height: .92em; border-radius: 50%; left: -.28em; top: 50%; transform: translateY(-50%); background: var(--orange); }
  .wordmark.teal-dot::before { background: var(--teal); }
  .t-orange { color: var(--orange); }
  .dot { width: 32px; height: 32px; border-radius: 50%; background: var(--teal); }
  .dot-sm { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); display: inline-block; }
  .hatch { width: 44px; height: 44px; border-radius: 50%; background: repeating-linear-gradient(45deg, transparent 0 2px, rgba(255,255,255,.65) 2px 3px); }

  .meta-rail { position: relative; padding: 22px 18px; border-right: 1px solid currentColor; min-width: 76px; background: var(--white); }
  .meta-rail .n { font-size: 17px; font-weight: 800; margin-bottom: 72px; }
  .meta-rail .year { position: absolute; left: 18px; bottom: 70px; font-size: 8px; line-height: 1.4; }
  .menu-mark { position: absolute; left: 18px; bottom: 18px; width: 22px; height: 14px; }
  .menu-mark::before, .menu-mark::after { content: ""; position: absolute; left: 0; height: 4px; border-radius: 4px; background: currentColor; }
  .menu-mark::before { width: 18px; top: 1px; } .menu-mark::after { width: 22px; bottom: 1px; }

  /* ===== COLLAGE ===== */
  .collage-page, body { background: var(--white); }
  .collage { max-width: 100%; margin: auto; display: grid; gap: 0; }
  .slide { min-height: 88vh; background: var(--white); box-shadow: var(--shadow); display: grid; overflow: hidden; position: relative; }
  .slide.teal { background: var(--teal); color: white; }
  .slide.orange { background: var(--orange); color: white; }
  .slide .content { padding: 40px; }

  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-solid { background: var(--orange); color: var(--charcoal); padding: 14px 26px; font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .btn-ghost { border: 1px solid rgba(255,255,255,.5); color: white; padding: 13px 24px; font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }

  /* terminal shared */
  .term { width: 100%; text-align: left; color: white; }
  .term-bar { display: flex; justify-content: space-between; align-items: center; padding-bottom: 8px; border-bottom: 1px solid rgba(255,255,255,.2); font-size: 8px; letter-spacing: .14em; }
  .term-title { color: rgba(255,255,255,.6); font-weight: 700; }
  .live { display: inline-flex; align-items: center; gap: 5px; color: var(--teal); font-weight: 800; }
  .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); animation: pulse 1.6s ease-in-out infinite; }
  @keyframes pulse { 0%,100% { opacity:1; box-shadow:0 0 0 0 rgba(19,185,182,.5);} 50% { opacity:.55; box-shadow:0 0 0 6px rgba(19,185,182,0);} }
  .term-body { padding-top: 10px; display: flex; flex-direction: column; gap: 7px; font-size: 9px; }
  .term-row { display: flex; gap: 8px; align-items: baseline; }
  .tl { width: 44px; color: rgba(255,255,255,.5); font-weight: 700; font-size: 7px; letter-spacing: .1em; }
  .tv { font-weight: 500; }
  .ok { color: var(--teal); font-weight: 800; }
  .rec { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--orange); animation: pulse 1.6s infinite; }
  .term-bc { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,.2); }
  .bc-bars { height: 14px; width: 70px; background-image: repeating-linear-gradient(90deg, white 0 2px, transparent 2px 4px, white 4px 5px, transparent 5px 9px); opacity: .6; }
  .bc-text { font-size: 6px; letter-spacing: .14em; color: rgba(255,255,255,.5); }

  /* SLIDE 1 — hero */
  .slide.one { grid-template-columns: 110px 1fr; background: var(--teal); color: white; }
  .slide.one .stage { display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: 30px; padding: 60px 6vw; }
  .slide.one .stage .content { padding: 0; }
  .slide.one .copy { color: rgba(255,255,255,.85); }
  .slide.one .btn-ghost { border-color: rgba(255,255,255,.5); }
  .photo-circle { width: min(26vw, 380px); height: min(26vw, 380px); border-radius: 50%; overflow: hidden; background: var(--charcoal); justify-self: center; display: flex; align-items: center; justify-content: center; padding: 52px; }

  /* SLIDE 2 — channels */
  .slide.two { grid-template-columns: 96px 1fr 1.25fr; background: var(--teal); color: white; }
  .slide.two .orange-pane { background: var(--orange); position: relative; padding: 30px; display: flex; flex-direction: column; }
  .slide.two .orange-pane .wordmark { color: var(--charcoal); }
  .chan-list { margin-top: 28px; display: flex; flex-direction: column; gap: 12px; }
  .chan-line { display: flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--charcoal); }
  .chan-line .dot-sm { background: var(--charcoal); }
  .chan-line .chk { margin-left: auto; font-weight: 900; color: var(--charcoal); }
  .slide.two .content { background: var(--white); color: var(--charcoal); }
  .thumb-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 24px; }
  .thumb { height: 90px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 900; letter-spacing: .14em; border: 2px solid var(--charcoal); }
  .t1 { background: var(--orange); color: var(--charcoal); }
  .t2 { background: var(--charcoal); color: white; }
  .t3 { background: var(--teal); color: white; }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
  .grid-2 .kicker { color: var(--teal); }

  /* SLIDE 3 — problem */
  .slide.three { grid-template-columns: 110px 1fr 92px; }
  .gallery { display: grid; gap: 10px; }
  .gal-big { height: 150px; background: var(--charcoal); color: white; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; }
  .gal-sm { height: 110px; background: var(--peach); color: var(--charcoal); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; border: 2px solid var(--charcoal); }
  .gal-big .x, .gal-sm .x { font-size: 20px; font-weight: 900; color: var(--burnt); }
