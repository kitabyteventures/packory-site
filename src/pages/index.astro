                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="how-rail" id="howRail" aria-label="Steps">
          <button type="button" data-go="0" class="active"><span>01</span></button>
          <button type="button" data-go="1"><span>02</span></button>
          <button type="button" data-go="2"><span>03</span></button>
          <button type="button" data-go="3"><span>04</span></button>
