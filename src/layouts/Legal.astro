---
import Base from './Base.astro';

export interface Props {
  title: string;
  description: string;
  effectiveDate?: Date;
}

const { title, description, effectiveDate } = Astro.props;
const prettyDate = effectiveDate
  ? new Date(effectiveDate).toLocaleDateString('en-MY', { day: 'numeric', month: 'long', year: 'numeric' })
  : '';
const CONSOLE = 'https://console.packory.app';
---

<Base title={`${title} | Packory`} description={description}>
  <header class="legal-nav">
    <div class="container legal-nav-inner">
      <a href="/" class="brand"><span class="brand-dot"></span>Packory</a>
      <nav class="links">
        <a href="/">Home</a>
        <a href="/blog">Blog</a>
        <a href={`${CONSOLE}/signup`} class="btn btn-primary btn-sm">Start Free</a>
      </nav>
    </div>
  </header>

  <main class="legal-wrap">
    <div class="container legal-container">
      <p class="legal-kicker">Packory · Legal</p>
      <h1 class="legal-title">{title}</h1>
      {prettyDate && <p class="legal-meta">Effective {prettyDate}</p>}
      <article class="legal-article">
        <slot />
      </article>

      <footer class="legal-foot">
        <span>© {new Date().getFullYear()} Packory</span>
        <span class="legal-links">
          <a href="/privacy">Privacy Policy</a>
          <a href="/terms">Terms of Service</a>
        </span>
        <a href="/">Back to packory.app</a>
      </footer>
    </div>
  </main>
</Base>

<style is:global>
  .legal-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: rgba(10, 13, 30, 0.92); backdrop-filter: blur(14px); border-bottom: 1px solid rgba(255, 255, 255, 0.1); }
  .legal-nav-inner { display: flex; align-items: center; justify-content: space-between; height: 4.25rem; }
  .legal-nav .brand { display: inline-flex; align-items: center; gap: 0.625rem; color: #fff; font-weight: 700; font-size: 1.15rem; }
  .brand-dot { width: 12px; height: 12px; border-radius: 3px; background: #2f4bff; display: inline-block; }
  .legal-nav .links { display: flex; align-items: center; gap: 1.5rem; font-size: 0.875rem; font-weight: 500; }
  .legal-nav .links a { color: #9aa3b2; }
  .legal-nav .links a:hover { color: #fff; }

  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; border-radius: 8px; font-weight: 600; font-size: 0.9375rem; padding: 0.75rem 1.5rem; transition: transform 0.15s, box-shadow 0.2s; }
  .btn:hover { transform: translateY(-2px); }
  .btn-primary { background: #2f4bff; color: #fff; box-shadow: 0 6px 20px rgba(47, 75, 255, 0.35); }
  .btn-sm { min-height: 2.5rem; padding: 0.4rem 1.25rem; font-size: 0.8125rem; }

  .legal-wrap { background: #f7f7f4; padding: 8rem 0 3rem; min-height: 100vh; }
  .legal-container { max-width: 46rem; }
  .legal-kicker { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #2f4bff; margin-bottom: 1rem; }
  .legal-title { font-size: clamp(1.9rem, 4.6vw, 2.9rem); line-height: 1.08; letter-spacing: -0.03em; color: #0a0d1e; margin-bottom: 0.6rem; text-wrap: balance; }
  .legal-meta { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #6b7280; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 2.5rem; }

  .legal-article { font-size: 1.0625rem; line-height: 1.75; color: #1c2237; }
  .legal-article h2 { font-size: 1.45rem; margin: 2.4rem 0 0.85rem; color: #0a0d1e; letter-spacing: -0.02em; }
  .legal-article h3 { font-size: 1.15rem; margin: 1.8rem 0 0.6rem; color: #0a0d1e; }
  .legal-article p { margin: 0 0 1.2rem; }
  .legal-article ul, .legal-article ol { margin: 0 0 1.2rem; padding-left: 1.4rem; }
  .legal-article li { margin-bottom: 0.45rem; }
  .legal-article strong { color: #0a0d1e; }
  .legal-article a { color: #2f4bff; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .legal-article hr { border: none; border-top: 1px solid rgba(10, 13, 30, 0.12); margin: 2.5rem 0; }
  .legal-article code { font-family: 'JetBrains Mono', monospace; font-size: 0.875em; background: #eceef5; padding: 0.15rem 0.4rem; border-radius: 5px; }

  .legal-foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem 1rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid rgba(10, 13, 30, 0.12); font-size: 0.8125rem; color: #6b7280; }
  .legal-foot a { color: #2f4bff; font-weight: 600; }
  .legal-links { display: inline-flex; gap: 1rem; }
</style>
