---
import Base from './Base.astro';

export interface Props {
  title: string;
  description: string;
  pubDate?: Date;
  author?: string;
}

const { title, description, pubDate, author = 'Packory' } = Astro.props;
const pretty = pubDate
  ? new Date(pubDate).toLocaleDateString('en-MY', { day: 'numeric', month: 'short', year: 'numeric' })
  : '';
const CONSOLE = 'https://console.packory.app';
---

<Base title={`${title} | Packory`} description={description}>
  <header class="blog-nav">
    <div class="container blog-nav-inner">
      <a href="/" class="brand"><span class="brand-dot"></span>Packory</a>
      <nav class="links">
        <a href="/">Home</a>
        <a href="/blog" class="active">Blog</a>
        <a href={`${CONSOLE}/signup`} class="btn btn-primary btn-sm">Start Free</a>
      </nav>
    </div>
  </header>

  <main class="blog-wrap">
    <div class="container blog-container">
      <p class="blog-kicker"><a href="/blog">← Packory Blog</a></p>
      <h1 class="blog-title">{title}</h1>
      <p class="blog-meta">{pretty} · {author}</p>
      <div class="blog-cover" aria-hidden="true">
        <span class="bc-brand"><i></i>Packory</span>
        <span class="bc-note">FIELD NOTES · FOR E-COMMERCE SELLERS</span>
        <span class="bc-chip">Dispute-proof your shop</span>
      </div>
      <div class="blog-actions">
        <button id="blogHeart" type="button" class="blog-heart" aria-pressed="false">
          <svg class="heart-svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7.5-4.7-10-9.3C.4 8.2 2.2 4.5 5.7 4.2c2-.2 3.7.9 4.6 2.4l1.7 2.6 1.7-2.6c.9-1.5 2.6-2.6 4.6-2.4 3.5.3 5.3 4 3.7 7.5C19.5 16.3 12 21 12 21z"/></svg>
          <span id="blogHeartLabel">Found this useful? Tap the heart.</span>
        </button>
      </div>
      <article class="blog-article">
        <slot />
      </article>

      <aside class="blog-cta">
        <p class="eyebrow-dark">GET STARTED</p>
        <h2>Put every order on the record.</h2>
        <p>Hands-free packing video, timestamped and dispute-proof. Free to start — your videos stay in your own Google Drive.</p>
        <div class="hero-actions">
          <a href={`${CONSOLE}/signup`} class="btn btn-primary">Start Free</a>
          <a href="/#workflow" class="btn btn-ghost-dark">See how it works</a>
        </div>
      </aside>

      <footer class="blog-foot">
        <span>© {new Date().getFullYear()} Packory</span>
        <a href="/">Back to packory.app</a>
      </footer>
    </div>
  </main>
</Base>

<script is:inline>
  const heart = document.getElementById('blogHeart');
  const label = document.getElementById('blogHeartLabel');
  if (heart && label && typeof localStorage !== 'undefined') {
    const key = 'pk_loved_' + location.pathname.replace(/[^a-z0-9]/gi, '_');
    const loved = localStorage.getItem(key) === '1';
    if (loved) {
      heart.classList.add('loved');
      heart.setAttribute('aria-pressed', 'true');
      label.textContent = 'Thanks — this helps other sellers. ♥';
    }
    heart.addEventListener('click', () => {
      const on = heart.classList.toggle('loved');
      heart.setAttribute('aria-pressed', String(on));
      label.textContent = on
        ? 'Thanks — this helps other sellers. ♥'
        : 'Found this useful? Tap the heart.';
      localStorage.setItem(key, on ? '1' : '0');
    });
  }
</script>

<style is:global>
  .blog-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: rgba(10, 13, 30, 0.92); backdrop-filter: blur(14px); border-bottom: 1px solid rgba(255, 255, 255, 0.1); }
  .blog-nav-inner { display: flex; align-items: center; justify-content: space-between; height: 4.25rem; }
  .blog-nav .brand { display: inline-flex; align-items: center; gap: 0.625rem; color: #fff; font-weight: 700; font-size: 1.15rem; }
  .brand-dot { width: 12px; height: 12px; border-radius: 3px; background: #2f4bff; display: inline-block; }
  .blog-nav .links { display: flex; align-items: center; gap: 1.5rem; font-size: 0.875rem; font-weight: 500; }
  .blog-nav .links a { color: #9aa3b2; }
  .blog-nav .links a:hover, .blog-nav .links a.active { color: #fff; }

  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; border-radius: 8px; font-weight: 600; font-size: 0.9375rem; padding: 0.75rem 1.5rem; transition: transform 0.15s, box-shadow 0.2s; }
  .btn:hover { transform: translateY(-2px); }
  .btn-primary { background: #2f4bff; color: #fff; box-shadow: 0 6px 20px rgba(47, 75, 255, 0.35); }
  .btn-sm { min-height: 2.5rem; padding: 0.4rem 1.25rem; font-size: 0.8125rem; }
  .btn-ghost-dark { border: 1px solid rgba(255, 255, 255, 0.2); color: #fff; }
  .eyebrow-dark { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #2f4bff; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }

  .blog-wrap { background: #f7f7f4; padding: 8rem 0 3rem; min-height: 100vh; }
  .blog-container { max-width: 46rem; }
  .blog-kicker { font-family: 'JetBrains Mono', monospace; font-size: 0.8125rem; margin-bottom: 1.5rem; }
  .blog-kicker a { color: #2f4bff; font-weight: 600; }
  .blog-title { font-size: clamp(1.9rem, 4.6vw, 2.9rem); line-height: 1.08; letter-spacing: -0.03em; color: #0a0d1e; margin-bottom: 0.75rem; text-wrap: balance; }
  .blog-meta { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #6b7280; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 2.5rem; }

  .blog-article { font-size: 1.0625rem; line-height: 1.75; color: #1c2237; }
  .blog-article h2 { font-size: 1.55rem; margin: 2.4rem 0 0.85rem; color: #0a0d1e; letter-spacing: -0.02em; }
  .blog-article h3 { font-size: 1.2rem; margin: 1.8rem 0 0.6rem; color: #0a0d1e; }
  .blog-article p { margin: 0 0 1.2rem; }
  .blog-article ul, .blog-article ol { margin: 0 0 1.2rem; padding-left: 1.4rem; }
  .blog-article li { margin-bottom: 0.45rem; }
  .blog-article strong { color: #0a0d1e; }
  .blog-article a { color: #2f4bff; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .blog-article blockquote { border-left: 4px solid #2f4bff; background: #fff; padding: 1rem 1.25rem; border-radius: 0 10px 10px 0; margin: 1.5rem 0; }
  .blog-article blockquote p { margin: 0; }
  .blog-article hr { border: none; border-top: 1px solid rgba(10, 13, 30, 0.12); margin: 2.5rem 0; }
  .blog-article code { font-family: 'JetBrains Mono', monospace; font-size: 0.875em; background: #eceef5; padding: 0.15rem 0.4rem; border-radius: 5px; }
  .blog-article img { border-radius: 12px; margin: 1.5rem 0; }

  .blog-cta { margin-top: 3.5rem; background: #0a0d1e; border-radius: 16px; padding: 2.5rem; }
  .blog-cta h2 { color: #fff; font-size: 1.75rem; margin-bottom: 0.75rem; letter-spacing: -0.02em; }
  .blog-cta p:not(.eyebrow-dark) { color: #9aa3b2; margin-bottom: 1.5rem; }
  .btn-ghost-dark { border: 1px solid rgba(255, 255, 255, 0.2); color: #fff; }

  .blog-foot { display: flex; justify-content: space-between; gap: 1rem; margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(10, 13, 30, 0.1); font-size: 0.8125rem; color: #6b7280; }
  .blog-foot a { color: #2f4bff; font-weight: 600; }

  .blog-cover{position:relative;overflow:hidden;border-radius:18px;margin:0 0 1.4rem;padding:30px 30px 26px;background:linear-gradient(118deg,#0a0d1e 0%,#10163a 52%,#1856ED 135%);color:#fff;display:flex;flex-direction:column;gap:6px;box-shadow:0 18px 44px -18px rgba(10,13,30,.5)}
  .blog-cover::after{content:'';position:absolute;width:220px;height:220px;right:-60px;top:-80px;border-radius:50%;background:radial-gradient(circle,rgba(47,75,255,.55),transparent 70%)}
  .bc-brand{display:inline-flex;align-items:center;gap:9px;font-weight:700;letter-spacing:-0.01em;font-size:1rem;position:relative;z-index:1}
  .bc-brand i{width:13px;height:13px;border-radius:4px;background:#2f4bff;display:inline-block}
  .bc-note{font-family:'JetBrains Mono',monospace;font-size:.68rem;letter-spacing:.22em;color:#8f9ad6;position:relative;z-index:1;margin-top:18px}
  .bc-chip{align-self:flex-start;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);color:#fff;font-size:.75rem;font-weight:600;padding:6px 12px;border-radius:999px;position:relative;z-index:1;margin-top:4px}
  .blog-actions{margin:-0.2rem 0 2rem}
  .blog-heart{display:inline-flex;align-items:center;gap:9px;background:#fff;border:1px solid rgba(10,13,30,.14);border-radius:999px;padding:9px 16px;font-size:.8125rem;font-weight:600;color:#0a0d1e;cursor:pointer;transition:all .15s;box-shadow:0 4px 14px rgba(10,13,30,.06)}
  .blog-heart:hover{border-color:#2f4bff;color:#2f4bff;transform:translateY(-1px)}
  .blog-heart.loved{background:#fff0f0;border-color:#ff6b6b;color:#e0245e}
  .blog-heart.loved .heart-svg{fill:#e0245e;stroke:#e0245e}
</style>
