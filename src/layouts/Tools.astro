---
import Base from './Base.astro';

export interface Props {
  title: string;
  description: string;
  /** Kebab path of the active top-level link (home | blog | tools). */
  active?: 'home' | 'blog' | 'tools';
}

const { title, description, active = 'tools' } = Astro.props;
const CONSOLE = 'https://console.packory.app';
const YEAR = new Date().getFullYear();
---

<Base title={`${title} | Packory`} description={description}>
  <header class="tools-nav">
    <div class="container tools-nav-inner">
      <a href="/" class="brand"><span class="brand-dot"></span>Packory</a>
      <nav class="links">
        <a href="/">Home</a>
        <a href="/blog">Blog</a>
        <a href="/tools" class={active === 'tools' ? 'active' : ''}>Tools</a>
        <a href={`${CONSOLE}/signup`} class="btn btn-primary btn-sm" data-pk-source>Start Free</a>
      </nav>
    </div>
  </header>

  <main class="tools-wrap">
    <slot />
  </main>

  <footer class="tools-foot">
    <div class="container tools-foot-inner">
      <span>© {YEAR} Packory · <a href="/tools">Free seller tools</a> · <a href="/blog">Blog</a> · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></span>
      <a href="/">Back to packory.app</a>
    </div>
  </footer>
</Base>

<script is:inline>
  // Source/lead attribution: simpan source param (source|utm_source|ref) bila nampak,
  // dan lekatkan pada SEMUA pautan "Start Free" (nav + body) supaya funnel konsisten.
  (function () {
    try {
      if (typeof localStorage === 'undefined') return;
      var params = new URLSearchParams(window.location.search);
      var src = params.get('source') || params.get('utm_source') || params.get('ref');
      var campaign = params.get('utm_campaign') || params.get('source_campaign');
      var key = 'pk_lead_source';
      if (src) {
        var val = campaign ? src + '|' + campaign : src;
        localStorage.setItem(key, val);
      }
      var stored = localStorage.getItem(key);
      if (stored) {
        var split = stored.split('|');
        var q = new URLSearchParams({ source: split[0] });
        if (split[1]) q.set('utm_campaign', split[1]);
        var suffix = q.toString();
        document.querySelectorAll('a[data-pk-source]').forEach(function (a) {
          var href = a.getAttribute('href') || '';
          a.setAttribute('href', href + (href.indexOf('?') >= 0 ? '&' : '?') + suffix);
        });
      }
    } catch (e) { /* attribution optional — jangan pernah break nav */ }
  })();
</script>

<style is:global>
  .tools-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: rgba(10, 13, 30, 0.92); backdrop-filter: blur(14px); border-bottom: 1px solid rgba(255, 255, 255, 0.1); }
  .tools-nav-inner { display: flex; align-items: center; justify-content: space-between; height: 4.25rem; }
  .tools-nav .brand { display: inline-flex; align-items: center; gap: 0.625rem; color: #fff; font-weight: 700; font-size: 1.15rem; }
  .brand-dot { width: 12px; height: 12px; border-radius: 3px; background: #2f4bff; display: inline-block; }
  .tools-nav .links { display: flex; align-items: center; gap: 1.25rem; font-size: 0.875rem; font-weight: 500; }
  .tools-nav .links a { color: #9aa3b2; }
  .tools-nav .links a:hover, .tools-nav .links a.active { color: #fff; }

  .tools-wrap { background: #f7f7f4; padding: 8rem 0 3rem; min-height: 100vh; }

  .tools-foot { border-top: 1px solid rgba(10, 13, 30, 0.1); background: #fff; }
  .tools-foot-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding-block: 1.75rem; font-size: 0.8125rem; color: #6b7280; }
  .tools-foot a { color: #2f4bff; font-weight: 600; }

  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; border-radius: 8px; font-weight: 600; font-size: 0.9375rem; padding: 0.75rem 1.5rem; transition: transform 0.15s, box-shadow 0.2s; }
  .btn:hover { transform: translateY(-2px); }
  .btn-primary { background: #2f4bff; color: #fff; box-shadow: 0 6px 20px rgba(47, 75, 255, 0.35); }
  .btn-sm { min-height: 2.5rem; padding: 0.4rem 1.25rem; font-size: 0.8125rem; }

  .eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #2f4bff; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }

  /* Responsive nav: mobile hamburger ringkas tanpa JS menu — pautan penting kekal. */
  @media (max-width: 720px) {
    .tools-nav .links a:not(.btn):not(.active) { display: none; }
    .tools-nav .links { gap: 0.75rem; }
  }
</style>
